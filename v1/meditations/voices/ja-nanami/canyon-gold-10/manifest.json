{
  "id": "canyon-gold-10",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 765,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "自分に何も求めない姿勢を見つけてください。",
      "file": "c001.ogg",
      "durationSec": 6.984
    },
    {
      "index": 2,
      "text": "必要なサポートを受けながら、座ったり、横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 10.032
    },
    {
      "index": 3,
      "text": "手を開いて、または柔らかく置いてください。",
      "file": "c003.ogg",
      "durationSec": 7.128
    },
    {
      "index": 4,
      "text": "目を閉じるか、優しい視線を保ちましょう。",
      "file": "c004.ogg",
      "durationSec": 7.176
    },
    {
      "index": 5,
      "text": "体と地面が接する場所を感じてください。",
      "file": "c005.ogg",
      "durationSec": 6.648
    },
    {
      "index": 6,
      "text": "かかと、座骨、後頭部、背骨の長さなどです。",
      "file": "c006.ogg",
      "durationSec": 9.048
    },
    {
      "index": 7,
      "text": "今のところ我慢できるものは何もありません。",
      "file": "c007.ogg",
      "durationSec": 6.816
    },
    {
      "index": 8,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c008.ogg",
      "durationSec": 5.52
    },
    {
      "index": 9,
      "text": "入ってくる空気の冷たさを感じてください。",
      "file": "c009.ogg",
      "durationSec": 6.864
    },
    {
      "index": 10,
      "text": "そして、少し長めに息を吐きます。",
      "file": "c010.ogg",
      "durationSec": 6.528
    },
    {
      "index": 11,
      "text": "出る呼気の温かさを感じてください。",
      "file": "c011.ogg",
      "durationSec": 6.072
    },
    {
      "index": 12,
      "text": "また。ソフトに吸い込みます。",
      "file": "c012.ogg",
      "durationSec": 6.552
    },
    {
      "index": 13,
      "text": "ゆっくりと息を吐きます。",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "肩を少し下げてみましょう。",
      "file": "c014.ogg",
      "durationSec": 5.016
    },
    {
      "index": 15,
      "text": "顎を緩めましょう。",
      "file": "c015.ogg",
      "durationSec": 3.936
    },
    {
      "index": 16,
      "text": "お腹を柔らかくしましょう。",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "そのままの状態で、静かな呼吸を 3 回続けてください。",
      "file": "c017.ogg",
      "durationSec": 9.144
    },
    {
      "index": 18,
      "text": "吸い込む。到着。",
      "file": "c018.ogg",
      "durationSec": 5.592
    },
    {
      "index": 19,
      "text": "息を吐きます。解決する。",
      "file": "c019.ogg",
      "durationSec": 6.648
    },
    {
      "index": 20,
      "text": "心がさまよったら、優しく気づいて、この呼吸に戻ってきてください。",
      "file": "c020.ogg",
      "durationSec": 10.584
    },
    {
      "index": 21,
      "text": "柔らかい金とバラで描かれた広い渓谷を想像してみてください。",
      "file": "c021.ogg",
      "durationSec": 9.288
    },
    {
      "index": 22,
      "text": "午後遅くです。光は寛大です。",
      "file": "c022.ogg",
      "durationSec": 7.464
    },
    {
      "index": 23,
      "text": "一日中太陽を受け止めた石からは温かさが伝わってきます。",
      "file": "c023.ogg",
      "durationSec": 9.648
    },
    {
      "index": 24,
      "text": "すねや手の甲に輻射熱を感じてください。",
      "file": "c024.ogg",
      "durationSec": 6.96
    },
    {
      "index": 25,
      "text": "乾いた新鮮な風が峡谷の床を伝わってきます。",
      "file": "c025.ogg",
      "durationSec": 8.064
    },
    {
      "index": 26,
      "text": "暖かさの快適さを損なうことなく、顔を冷やします。",
      "file": "c026.ogg",
      "durationSec": 8.736
    },
    {
      "index": 27,
      "text": "静かな壁の間の砂の道を歩きます。",
      "file": "c027.ogg",
      "durationSec": 6.816
    },
    {
      "index": 28,
      "text": "足音がささやきます。エコーは柔らかく、ほとんど丁寧です。",
      "file": "c028.ogg",
      "durationSec": 11.016
    },
    {
      "index": 29,
      "text": "日に焼けた土、セージ、きれいなほこりの香り。",
      "file": "c029.ogg",
      "durationSec": 7.896
    },
    {
      "index": 30,
      "text": "滑らかな石の上に手のひらを置きます。",
      "file": "c030.ogg",
      "durationSec": 6.384
    },
    {
      "index": 31,
      "text": "そこには太陽の光が蓄えられているのを感じます。安定した忍耐強い熱です。",
      "file": "c031.ogg",
      "durationSec": 13.392
    },
    {
      "index": 32,
      "text": "シェードのリボンが、数歩歩くだけで涼しさをもたらします。",
      "file": "c032.ogg",
      "durationSec": 9.048
    },
    {
      "index": 33,
      "text": "それからまた太陽の光を浴びて、ショールのように肩を温めてください。",
      "file": "c033.ogg",
      "durationSec": 10.704
    },
    {
      "index": 34,
      "text": "渓谷が開けた場所に出ます。",
      "file": "c034.ogg",
      "durationSec": 4.968
    },
    {
      "index": 35,
      "text": "黄金色の暖かさをまだ保っている平らな岩の上に座ってください。",
      "file": "c035.ogg",
      "durationSec": 9.96
    },
    {
      "index": 36,
      "text": "座席と背骨を通って上昇するのを感じてください。",
      "file": "c036.ogg",
      "durationSec": 7.92
    },
    {
      "index": 37,
      "text": "吸い込むたびに高地の新鮮な空気を感じてください。",
      "file": "c037.ogg",
      "durationSec": 8.376
    },
    {
      "index": 38,
      "text": "はるか上空では、鷹が急ぐことなくゆっくりと旋回しています。",
      "file": "c038.ogg",
      "durationSec": 9.792
    },
    {
      "index": 39,
      "text": "そのゆったりとした性質を借りています。",
      "file": "c039.ogg",
      "durationSec": 6.336
    },
    {
      "index": 40,
      "text": "息を長くしてください。体が重い。壁の間の空のように心を広く持ちましょう。",
      "file": "c040.ogg",
      "durationSec": 15.312
    },
    {
      "index": 41,
      "text": "太陽が沈むにつれて、影が遠くの崖を登っていくのを見てください。",
      "file": "c041.ogg",
      "durationSec": 10.248
    },
    {
      "index": 42,
      "text": "色が深まります。暖かさは柔らかくなりますが、消えません。",
      "file": "c042.ogg",
      "durationSec": 10.824
    },
    {
      "index": 43,
      "text": "そよ風は今では涼しく、夕方のように爽やかな香りがします。",
      "file": "c043.ogg",
      "durationSec": 9.936
    },
    {
      "index": 44,
      "text": "少しの間、腕を自分の体に巻き付けてください。",
      "file": "c044.ogg",
      "durationSec": 8.136
    },
    {
      "index": 45,
      "text": "自分の体の温もり。石の温もり。十分。",
      "file": "c045.ogg",
      "durationSec": 10.512
    },
    {
      "index": 46,
      "text": "注意深く横になって、最初の静かな星を眺めてください。",
      "file": "c046.ogg",
      "durationSec": 9.36
    },
    {
      "index": 47,
      "text": "カップ状の手が水を握るように、渓谷はあなたを優しく、こぼさずに抱きしめます。",
      "file": "c047.ogg",
      "durationSec": 12.912
    },
    {
      "index": 48,
      "text": "その抱いた感情の中で休んでください。",
      "file": "c048.ogg",
      "durationSec": 6.648
    },
    {
      "index": 49,
      "text": "岩から冷たい空気の中に最後の熱が上昇していることに注目してください。",
      "file": "c049.ogg",
      "durationSec": 11.712
    },
    {
      "index": 50,
      "text": "風が今、夕暮れと埃とセージの香りを漂わせていることに注目してください。",
      "file": "c050.ogg",
      "durationSec": 11.784
    },
    {
      "index": 51,
      "text": "静かな空間に合わせてあなたの呼吸も遅くなりました。",
      "file": "c051.ogg",
      "durationSec": 8.664
    },
    {
      "index": 52,
      "text": "眉に緊張が残っている場合は、このゴールドの光で眉を柔らかくします。",
      "file": "c052.ogg",
      "durationSec": 11.352
    },
    {
      "index": 53,
      "text": "顎が固い場合は、鷹が簡単に回転できるように、顎を緩めてください。",
      "file": "c053.ogg",
      "durationSec": 11.544
    },
    {
      "index": 54,
      "text": "暖かい石と新鮮な空気をさらに数サイクル過ごしましょう。",
      "file": "c054.ogg",
      "durationSec": 9.24
    },
    {
      "index": 55,
      "text": "あなたは遅れていません。あなたはここにいる。",
      "file": "c055.ogg",
      "durationSec": 8.28
    },
    {
      "index": 56,
      "text": "峡谷の壁の間の暖かい砂に沿ってさらに数歩歩きます。",
      "file": "c056.ogg",
      "durationSec": 9.576
    },
    {
      "index": 57,
      "text": "あなたの影は心配することなく長く伸びます。",
      "file": "c057.ogg",
      "durationSec": 7.272
    },
    {
      "index": 58,
      "text": "もう一度両手のひらを石の上に置きます。",
      "file": "c058.ogg",
      "durationSec": 6.6
    },
    {
      "index": 59,
      "text": "獲得する必要のない祝福のように、熱が手に伝わります。",
      "file": "c059.ogg",
      "durationSec": 9.312
    },
    {
      "index": 60,
      "text": "風が髪を涼しくしてくれます。",
      "file": "c060.ogg",
      "durationSec": 5.52
    },
    {
      "index": 61,
      "text": "セージの香り。ほこりの香り。太陽の香り。",
      "file": "c061.ogg",
      "durationSec": 10.392
    },
    {
      "index": 62,
      "text": "座る。膝が柔らかい。背骨が楽。",
      "file": "c062.ogg",
      "durationSec": 9.456
    },
    {
      "index": 63,
      "text": "時計の色はゴールドからローズに向かって深まります。",
      "file": "c063.ogg",
      "durationSec": 7.824
    },
    {
      "index": 64,
      "text": "暖かさが柔らかくなります。鮮度が上がります。残高は残ります。",
      "file": "c064.ogg",
      "durationSec": 12.72
    },
    {
      "index": 65,
      "text": "このようにして、夜は神経系にシフトダウンを教えるのです。",
      "file": "c065.ogg",
      "durationSec": 9.408
    },
    {
      "index": 66,
      "text": "手間をかけずにレッスンを借りましょう。",
      "file": "c066.ogg",
      "durationSec": 5.616
    },
    {
      "index": 67,
      "text": "石のために3回の呼吸。",
      "file": "c067.ogg",
      "durationSec": 5.28
    },
    {
      "index": 68,
      "text": "空への3つ。",
      "file": "c068.ogg",
      "durationSec": 3.48
    },
    {
      "index": 69,
      "text": "あなた自身の体の静かな動物、休息のための 3 つ。",
      "file": "c069.ogg",
      "durationSec": 9.336
    },
    {
      "index": 70,
      "text": "さて、物語は休んで、感覚を保ってください。",
      "file": "c070.ogg",
      "durationSec": 8.592
    },
    {
      "index": 71,
      "text": "この場所の新鮮さを吸い込んでください。",
      "file": "c071.ogg",
      "durationSec": 6.168
    },
    {
      "index": 72,
      "text": "その温かさと静けさの中に息を吐き出します。",
      "file": "c072.ogg",
      "durationSec": 7.848
    },
    {
      "index": 73,
      "text": "吸い込む。",
      "file": "c073.ogg",
      "durationSec": 2.88
    },
    {
      "index": 74,
      "text": "息を吐きます。",
      "file": "c074.ogg",
      "durationSec": 3.504
    },
    {
      "index": 75,
      "text": "また。ソフトに吸い込みます。",
      "file": "c075.ogg",
      "durationSec": 6.552
    },
    {
      "index": 76,
      "text": "息を長く吐く。",
      "file": "c076.ogg",
      "durationSec": 3.888
    },
    {
      "index": 77,
      "text": "この想像の世界の地面に身体が支えられているのを感じてください。",
      "file": "c077.ogg",
      "durationSec": 10.056
    },
    {
      "index": 78,
      "text": "吸い込む。",
      "file": "c078.ogg",
      "durationSec": 2.88
    },
    {
      "index": 79,
      "text": "息を吐きます。",
      "file": "c079.ogg",
      "durationSec": 3.504
    },
    {
      "index": 80,
      "text": "考えがさまよったら、皮膚の温もりに戻りましょう。",
      "file": "c080.ogg",
      "durationSec": 7.728
    },
    {
      "index": 81,
      "text": "あるいは鼻の空気を冷やすためです。",
      "file": "c081.ogg",
      "durationSec": 6.36
    },
    {
      "index": 82,
      "text": "吸い込む。",
      "file": "c082.ogg",
      "durationSec": 2.88
    },
    {
      "index": 83,
      "text": "息を吐きます。",
      "file": "c083.ogg",
      "durationSec": 3.504
    },
    {
      "index": 84,
      "text": "吸い込む。",
      "file": "c084.ogg",
      "durationSec": 2.88
    },
    {
      "index": 85,
      "text": "息を吐きます。",
      "file": "c085.ogg",
      "durationSec": 3.504
    },
    {
      "index": 86,
      "text": "滞在する。柔らかくする。続く。",
      "file": "c086.ogg",
      "durationSec": 9.192
    },
    {
      "index": 87,
      "text": "吸い込む。",
      "file": "c087.ogg",
      "durationSec": 2.88
    },
    {
      "index": 88,
      "text": "息を吐きます。",
      "file": "c088.ogg",
      "durationSec": 3.504
    },
    {
      "index": 89,
      "text": "もう 1 つの簡単なサイクル。",
      "file": "c089.ogg",
      "durationSec": 5.184
    },
    {
      "index": 90,
      "text": "吸い込む。",
      "file": "c090.ogg",
      "durationSec": 2.88
    },
    {
      "index": 91,
      "text": "息を吐きます。",
      "file": "c091.ogg",
      "durationSec": 3.504
    },
    {
      "index": 92,
      "text": "この感覚をもう少し呼吸してください。",
      "file": "c092.ogg",
      "durationSec": 6.384
    },
    {
      "index": 93,
      "text": "暖かさ。柔らかさ。十分です。",
      "file": "c093.ogg",
      "durationSec": 9.12
    },
    {
      "index": 94,
      "text": "必要なときにいつでもこの場所に戻ることができます。",
      "file": "c094.ogg",
      "durationSec": 7.872
    },
    {
      "index": 95,
      "text": "それは想像力の中だけではなく、あなたの注意力の中に生きています。",
      "file": "c095.ogg",
      "durationSec": 10.704
    },
    {
      "index": 96,
      "text": "呼吸を深め始めます。",
      "file": "c096.ogg",
      "durationSec": 4.584
    },
    {
      "index": 97,
      "text": "あなたの周りの部屋をもう一度感じてください。",
      "file": "c097.ogg",
      "durationSec": 7.008
    },
    {
      "index": 98,
      "text": "指を小刻みに動かします。つま先を柔らかくします。",
      "file": "c098.ogg",
      "durationSec": 9.936
    },
    {
      "index": 99,
      "text": "準備ができたら、目を開けてください。",
      "file": "c099.ogg",
      "durationSec": 5.976
    },
    {
      "index": 100,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c100.ogg",
      "durationSec": 5.664
    },
    {
      "index": 101,
      "text": "この平穏を次に何が起こっても持ち続けてください。",
      "file": "c101.ogg",
      "durationSec": 7.944
    }
  ]
}
