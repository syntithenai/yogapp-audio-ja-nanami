{
  "id": "cove-shore-5",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 416,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "快適な座席に座るか、気分が良い場合は横になってください。",
      "file": "c001.ogg",
      "durationSec": 9.72
    },
    {
      "index": 2,
      "text": "手を休めましょう。",
      "file": "c002.ogg",
      "durationSec": 3.888
    },
    {
      "index": 3,
      "text": "目を閉じるか、視線を和らげてください。",
      "file": "c003.ogg",
      "durationSec": 6.744
    },
    {
      "index": 4,
      "text": "身体が支えられている重さに注目してください。",
      "file": "c004.ogg",
      "durationSec": 7.536
    },
    {
      "index": 5,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c005.ogg",
      "durationSec": 5.52
    },
    {
      "index": 6,
      "text": "そして長く楽に息を吐くことができます。",
      "file": "c006.ogg",
      "durationSec": 6.984
    },
    {
      "index": 7,
      "text": "また。ソフトに吸い込みます。",
      "file": "c007.ogg",
      "durationSec": 6.552
    },
    {
      "index": 8,
      "text": "ゆっくりと息を吐きます。",
      "file": "c008.ogg",
      "durationSec": 4.584
    },
    {
      "index": 9,
      "text": "考えがさまよっても、それは問題ありません。呼吸に戻ります。",
      "file": "c009.ogg",
      "durationSec": 10.824
    },
    {
      "index": 10,
      "text": "保護された入り江に到着したところを想像してください。",
      "file": "c010.ogg",
      "durationSec": 7.848
    },
    {
      "index": 11,
      "text": "崖は柔らかく青白い砂の周りで曲がります。",
      "file": "c011.ogg",
      "durationSec": 7.584
    },
    {
      "index": 12,
      "text": "海は低く忍耐強く波を立てます。",
      "file": "c012.ogg",
      "durationSec": 6.312
    },
    {
      "index": 13,
      "text": "穏やかな日差しが肩の上を温めます。",
      "file": "c013.ogg",
      "durationSec": 6.624
    },
    {
      "index": 14,
      "text": "潮風が唇とまぶたを冷やします。",
      "file": "c014.ogg",
      "durationSec": 6.312
    },
    {
      "index": 15,
      "text": "胸に広がる清々しい空気を感じてください。",
      "file": "c015.ogg",
      "durationSec": 7.224
    },
    {
      "index": 16,
      "text": "水線まで歩きます。濡れた砂が足を包み込みます。",
      "file": "c016.ogg",
      "durationSec": 9.816
    },
    {
      "index": 17,
      "text": "冷たい泡が足首に触れると滑り落ちます。",
      "file": "c017.ogg",
      "durationSec": 7.416
    },
    {
      "index": 18,
      "text": "リズムはシンプルです。到着。柔らかくする。離れる。",
      "file": "c018.ogg",
      "durationSec": 13.008
    },
    {
      "index": 19,
      "text": "乾いた砂が足元で温かい場所に座ってください。",
      "file": "c019.ogg",
      "durationSec": 8.304
    },
    {
      "index": 20,
      "text": "両手にもたれかかります。粒状の熱を感じてください。",
      "file": "c020.ogg",
      "durationSec": 9.696
    },
    {
      "index": 21,
      "text": "入り江の静寂と急流に耳を傾けてください。",
      "file": "c021.ogg",
      "durationSec": 7.512
    },
    {
      "index": 22,
      "text": "塩、太陽、そしてきれいな石の香り。",
      "file": "c022.ogg",
      "durationSec": 7.368
    },
    {
      "index": 23,
      "text": "肌に伝わる温もり。吸い込むたびに涼しさ。",
      "file": "c023.ogg",
      "durationSec": 8.76
    },
    {
      "index": 24,
      "text": "遠くで、静かな笑い声のように光が輝いています。",
      "file": "c024.ogg",
      "durationSec": 8.808
    },
    {
      "index": 25,
      "text": "追いかける必要はありません。それはすでにここにあります。",
      "file": "c025.ogg",
      "durationSec": 9.672
    },
    {
      "index": 26,
      "text": "波はさらに遠くまで届き、つま先を冷やしてから遠ざかります。",
      "file": "c026.ogg",
      "durationSec": 9.84
    },
    {
      "index": 27,
      "text": "温かい砂が足を取り戻します。",
      "file": "c027.ogg",
      "durationSec": 5.808
    },
    {
      "index": 28,
      "text": "呼吸を波に合わせて動かしましょう。ゆっくりと入って、長く吐き出します。",
      "file": "c028.ogg",
      "durationSec": 12.168
    },
    {
      "index": 29,
      "text": "平和は入り江そのものです。あなたはその中にいます。",
      "file": "c029.ogg",
      "durationSec": 9.432
    },
    {
      "index": 30,
      "text": "肩甲骨の間の温かさに注目してください。",
      "file": "c030.ogg",
      "durationSec": 7.464
    },
    {
      "index": 31,
      "text": "そして鼻先の新鮮な塩気の上で。",
      "file": "c031.ogg",
      "durationSec": 6.936
    },
    {
      "index": 32,
      "text": "柔らかな想像力で崖線をたどりましょう。",
      "file": "c032.ogg",
      "durationSec": 7.272
    },
    {
      "index": 33,
      "text": "日によって温められた石。ひだの影が涼しげです。",
      "file": "c033.ogg",
      "durationSec": 9.696
    },
    {
      "index": 34,
      "text": "近くの潮溜まりには小さな透明な世界が広がっています。",
      "file": "c034.ogg",
      "durationSec": 9.144
    },
    {
      "index": 35,
      "text": "身を乗り出す必要はありません。そこにあると知っていれば十分です。",
      "file": "c035.ogg",
      "durationSec": 10.824
    },
    {
      "index": 36,
      "text": "また波が。足首も涼しげ。温かい砂。柔らかな息。",
      "file": "c036.ogg",
      "durationSec": 13.752
    },
    {
      "index": 37,
      "text": "入り江は変わらぬ素朴な優しさを提供し続けます。",
      "file": "c037.ogg",
      "durationSec": 7.824
    },
    {
      "index": 38,
      "text": "出発前にもう一度受け取ってください。",
      "file": "c038.ogg",
      "durationSec": 6.288
    },
    {
      "index": 39,
      "text": "それでは、少しの間、一人で呼吸の中で休んでください。",
      "file": "c039.ogg",
      "durationSec": 9.72
    },
    {
      "index": 40,
      "text": "ゆっくりと吸い込みます。",
      "file": "c040.ogg",
      "durationSec": 4.368
    },
    {
      "index": 41,
      "text": "ゆっくりと息を吐きます。",
      "file": "c041.ogg",
      "durationSec": 4.584
    },
    {
      "index": 42,
      "text": "吸い込む。",
      "file": "c042.ogg",
      "durationSec": 2.88
    },
    {
      "index": 43,
      "text": "息を吐きます。",
      "file": "c043.ogg",
      "durationSec": 3.504
    },
    {
      "index": 44,
      "text": "体が温かいところはどこでも温かさを感じます。",
      "file": "c044.ogg",
      "durationSec": 8.256
    },
    {
      "index": 45,
      "text": "空気が冷たければどこでも涼しさを感じます。",
      "file": "c045.ogg",
      "durationSec": 7.344
    },
    {
      "index": 46,
      "text": "吸い込む。",
      "file": "c046.ogg",
      "durationSec": 2.88
    },
    {
      "index": 47,
      "text": "息を吐きます。",
      "file": "c047.ogg",
      "durationSec": 3.504
    },
    {
      "index": 48,
      "text": "どこにも行くところがない。修正するものは何もありません。",
      "file": "c048.ogg",
      "durationSec": 9.84
    },
    {
      "index": 49,
      "text": "吸い込む。",
      "file": "c049.ogg",
      "durationSec": 2.88
    },
    {
      "index": 50,
      "text": "息を吐きます。",
      "file": "c050.ogg",
      "durationSec": 3.504
    },
    {
      "index": 51,
      "text": "ここで数回静かに呼吸してください。",
      "file": "c051.ogg",
      "durationSec": 6.24
    },
    {
      "index": 52,
      "text": "いつでもこの場所に戻れることを知っておいてください。",
      "file": "c052.ogg",
      "durationSec": 7.44
    },
    {
      "index": 53,
      "text": "準備ができたら、呼吸を深めてください。",
      "file": "c053.ogg",
      "durationSec": 6.648
    },
    {
      "index": 54,
      "text": "指や足の指を小刻みに動かします。",
      "file": "c054.ogg",
      "durationSec": 6.84
    },
    {
      "index": 55,
      "text": "そっと目を開けてください。",
      "file": "c055.ogg",
      "durationSec": 4.536
    },
    {
      "index": 56,
      "text": "この平和を少しでも持ち歩きましょう。",
      "file": "c056.ogg",
      "durationSec": 6.24
    }
  ]
}
