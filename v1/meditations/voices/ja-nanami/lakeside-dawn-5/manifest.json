{
  "id": "lakeside-dawn-5",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 438,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "快適な座席に座るか、気分が良い場合は横になってください。",
      "file": "c001.ogg",
      "durationSec": 9.72
    },
    {
      "index": 2,
      "text": "手を休めましょう。",
      "file": "c002.ogg",
      "durationSec": 3.888
    },
    {
      "index": 3,
      "text": "目を閉じるか、視線を和らげてください。",
      "file": "c003.ogg",
      "durationSec": 6.744
    },
    {
      "index": 4,
      "text": "身体が支えられている重さに注目してください。",
      "file": "c004.ogg",
      "durationSec": 7.536
    },
    {
      "index": 5,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c005.ogg",
      "durationSec": 5.52
    },
    {
      "index": 6,
      "text": "そして長く楽に息を吐くことができます。",
      "file": "c006.ogg",
      "durationSec": 6.984
    },
    {
      "index": 7,
      "text": "また。ソフトに吸い込みます。",
      "file": "c007.ogg",
      "durationSec": 6.552
    },
    {
      "index": 8,
      "text": "ゆっくりと息を吐きます。",
      "file": "c008.ogg",
      "durationSec": 4.584
    },
    {
      "index": 9,
      "text": "考えがさまよっても、それは問題ありません。呼吸に戻ります。",
      "file": "c009.ogg",
      "durationSec": 10.824
    },
    {
      "index": 10,
      "text": "夜明けの静かな湖のほとりにいる自分を想像してみてください。",
      "file": "c010.ogg",
      "durationSec": 9.168
    },
    {
      "index": 11,
      "text": "水面には淡い銀色の空が広がっています。",
      "file": "c011.ogg",
      "durationSec": 7.464
    },
    {
      "index": 12,
      "text": "冷たい空気が頬を清涼感たっぷりに撫でます。",
      "file": "c012.ogg",
      "durationSec": 7.752
    },
    {
      "index": 13,
      "text": "柔らかな太陽のリボンがあなたの肩を温め始めます。",
      "file": "c013.ogg",
      "durationSec": 8.928
    },
    {
      "index": 14,
      "text": "背中にじんわりと温かさが広がっていくのを感じてください。",
      "file": "c014.ogg",
      "durationSec": 8.688
    },
    {
      "index": 15,
      "text": "あなたは一歩近づきます。柔らかい砂が足裏に広がります。",
      "file": "c015.ogg",
      "durationSec": 10.728
    },
    {
      "index": 16,
      "text": "指先を水に浸します。いいね。クリア。",
      "file": "c016.ogg",
      "durationSec": 9.768
    },
    {
      "index": 17,
      "text": "波紋は外側に伝わり消えていきます。",
      "file": "c017.ogg",
      "durationSec": 6.432
    },
    {
      "index": 18,
      "text": "風にかすかに水草と朝の香りが漂います。",
      "file": "c018.ogg",
      "durationSec": 7.944
    },
    {
      "index": 19,
      "text": "聞く。ほとんど何もありません。遠くにいる鳥。あなた自身の呼吸。",
      "file": "c019.ogg",
      "durationSec": 14.184
    },
    {
      "index": 20,
      "text": "昇る光で十分に温められた滑らかな石の上に座ります。",
      "file": "c020.ogg",
      "durationSec": 9.408
    },
    {
      "index": 21,
      "text": "石の静かな熱を体の下で感じてください。",
      "file": "c021.ogg",
      "durationSec": 7.512
    },
    {
      "index": 22,
      "text": "肺に入ってくる空気の新鮮さを感じてください。",
      "file": "c022.ogg",
      "durationSec": 7.728
    },
    {
      "index": 23,
      "text": "湖は柔らかなピンクと金色に輝いています。",
      "file": "c023.ogg",
      "durationSec": 7.896
    },
    {
      "index": 24,
      "text": "ゆっくりとした呼吸のように、光が表面を移動するのを観察します。",
      "file": "c024.ogg",
      "durationSec": 10.344
    },
    {
      "index": 25,
      "text": "魚が上がり、リングが広がり、そして鏡が戻ります。",
      "file": "c025.ogg",
      "durationSec": 9.288
    },
    {
      "index": 26,
      "text": "閉じた瞼に温もりを。",
      "file": "c026.ogg",
      "durationSec": 4.656
    },
    {
      "index": 27,
      "text": "手の甲に涼しさを。",
      "file": "c027.ogg",
      "durationSec": 4.152
    },
    {
      "index": 28,
      "text": "どこか遠くで、ボートのロープが木に当たってカチカチと音を立てます。",
      "file": "c028.ogg",
      "durationSec": 10.368
    },
    {
      "index": 29,
      "text": "それから再び沈黙します、広くて親切です。",
      "file": "c029.ogg",
      "durationSec": 8.16
    },
    {
      "index": 30,
      "text": "涼しい朝を吸い込んでください。開いた水の中に息を吐き出します。",
      "file": "c030.ogg",
      "durationSec": 11.424
    },
    {
      "index": 31,
      "text": "平和は、水から霧が立ち上がるように、穏やかに、完全に落ち着きます。",
      "file": "c031.ogg",
      "durationSec": 11.496
    },
    {
      "index": 32,
      "text": "この静けさの中でスペースを取ることは許されています。",
      "file": "c032.ogg",
      "durationSec": 8.472
    },
    {
      "index": 33,
      "text": "夜明けのひと息をもう一度味わいましょう。",
      "file": "c033.ogg",
      "durationSec": 6.432
    },
    {
      "index": 34,
      "text": "水面に映る銀色の光の道をもう一度見てください。",
      "file": "c034.ogg",
      "durationSec": 8.472
    },
    {
      "index": 35,
      "text": "優しい目で向こう岸まで追いかけてください。",
      "file": "c035.ogg",
      "durationSec": 6.624
    },
    {
      "index": 36,
      "text": "向こうの木々は遠くと朝霧で青くなっています。",
      "file": "c036.ogg",
      "durationSec": 7.8
    },
    {
      "index": 37,
      "text": "日が昇るにつれて、肩に少しずつ暖かさが増してきます。",
      "file": "c037.ogg",
      "durationSec": 9.36
    },
    {
      "index": 38,
      "text": "湖から生まれた清潔な風は常に新鮮です。",
      "file": "c038.ogg",
      "durationSec": 8.4
    },
    {
      "index": 39,
      "text": "光が表面を洗い流すように、その新鮮さが心を洗い流してください。",
      "file": "c039.ogg",
      "durationSec": 11.544
    },
    {
      "index": 40,
      "text": "さらに 3 回座って、温かさと冷たい空気を一緒に呼吸しましょう。",
      "file": "c040.ogg",
      "durationSec": 10.896
    },
    {
      "index": 41,
      "text": "それでは、少しの間、一人で呼吸の中で休んでください。",
      "file": "c041.ogg",
      "durationSec": 9.72
    },
    {
      "index": 42,
      "text": "ゆっくりと吸い込みます。",
      "file": "c042.ogg",
      "durationSec": 4.368
    },
    {
      "index": 43,
      "text": "ゆっくりと息を吐きます。",
      "file": "c043.ogg",
      "durationSec": 4.584
    },
    {
      "index": 44,
      "text": "吸い込む。",
      "file": "c044.ogg",
      "durationSec": 2.88
    },
    {
      "index": 45,
      "text": "息を吐きます。",
      "file": "c045.ogg",
      "durationSec": 3.504
    },
    {
      "index": 46,
      "text": "体が温かいところはどこでも温かさを感じます。",
      "file": "c046.ogg",
      "durationSec": 8.256
    },
    {
      "index": 47,
      "text": "空気が冷たければどこでも涼しさを感じます。",
      "file": "c047.ogg",
      "durationSec": 7.344
    },
    {
      "index": 48,
      "text": "吸い込む。",
      "file": "c048.ogg",
      "durationSec": 2.88
    },
    {
      "index": 49,
      "text": "息を吐きます。",
      "file": "c049.ogg",
      "durationSec": 3.504
    },
    {
      "index": 50,
      "text": "どこにも行くところがない。修正するものは何もありません。",
      "file": "c050.ogg",
      "durationSec": 9.84
    },
    {
      "index": 51,
      "text": "吸い込む。",
      "file": "c051.ogg",
      "durationSec": 2.88
    },
    {
      "index": 52,
      "text": "息を吐きます。",
      "file": "c052.ogg",
      "durationSec": 3.504
    },
    {
      "index": 53,
      "text": "ここで数回静かに呼吸してください。",
      "file": "c053.ogg",
      "durationSec": 6.24
    },
    {
      "index": 54,
      "text": "いつでもこの場所に戻れることを知っておいてください。",
      "file": "c054.ogg",
      "durationSec": 7.44
    },
    {
      "index": 55,
      "text": "準備ができたら、呼吸を深めてください。",
      "file": "c055.ogg",
      "durationSec": 6.648
    },
    {
      "index": 56,
      "text": "指や足の指を小刻みに動かします。",
      "file": "c056.ogg",
      "durationSec": 6.84
    },
    {
      "index": 57,
      "text": "そっと目を開けてください。",
      "file": "c057.ogg",
      "durationSec": 4.536
    },
    {
      "index": 58,
      "text": "この平和を少しでも持ち歩きましょう。",
      "file": "c058.ogg",
      "durationSec": 6.24
    }
  ]
}
