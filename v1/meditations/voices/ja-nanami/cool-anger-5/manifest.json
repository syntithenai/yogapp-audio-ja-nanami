  "totalSec": 131,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "怒りやイライラがある場合は、ここにお越しください。",
      "file": "c001.ogg",
      "durationSec": 7.752
    },
    {
      "index": 2,
      "text": "消す必要はありません。",
      "file": "c002.ogg",
      "durationSec": 4.464
    },
    {
      "index": 3,
      "text": "もっとスペースを与えてください。",
      "file": "c003.ogg",
      "durationSec": 5.208
    },
    {
      "index": 4,
      "text": "足を感じてください。",
      "file": "c004.ogg",
      "durationSec": 4.32
    },
    {
      "index": 5,
      "text": "[休止:25]",
      "file": "c005.ogg",
      "durationSec": 3.768
    },
    {
      "index": 6,
      "text": "4回吸います。",
      "file": "c006.ogg",
      "durationSec": 3.672
    },
    {
      "index": 7,
      "text": "6、8回息を吐きます。",
      "file": "c007.ogg",
      "durationSec": 5.544
    },
    {
      "index": 8,
      "text": "息を長く吐くとシステムが冷却されます。",
      "file": "c008.ogg",
      "durationSec": 6.912
    },
    {
      "index": 9,
      "text": "[休止:33]",
      "file": "c009.ogg",
      "durationSec": 4.392
    },
    {
      "index": 10,
      "text": "また。",
      "file": "c010.ogg",
      "durationSec": 2.376
    },
    {
      "index": 11,
      "text": "[休止:33]",
      "file": "c011.ogg",
      "durationSec": 4.392
    },
    {
      "index": 12,
      "text": "ストーリーに影響を与えることなく、熱に名前を付けます。",
      "file": "c012.ogg",
      "durationSec": 8.976
    },
    {
      "index": 13,
      "text": "胸が熱くなる。きつい顎。頭の回転が速い。",
      "file": "c013.ogg",
      "durationSec": 11.016
    },
    {
      "index": 14,
      "text": "[休止:41]",
      "file": "c014.ogg",
      "durationSec": 4.32
    },
    {
      "index": 15,
      "text": "手を柔らかくします。",
      "file": "c015.ogg",
      "durationSec": 4.08
    },
    {
      "index": 16,
      "text": "肩を落とします。",
      "file": "c016.ogg",
      "durationSec": 3.648
    },
    {
      "index": 17,
      "text": "[休止:33]",
      "file": "c017.ogg",
      "durationSec": 4.392
    },
    {
      "index": 18,
      "text": "後でわかりやすい場所から応答できます。",
      "file": "c018.ogg",
      "durationSec": 6.408
    },
    {
      "index": 19,
      "text": "とりあえず、息をしてください。",
      "file": "c019.ogg",
      "durationSec": 5.376
    },
    {
      "index": 20,
      "text": "[休止:45]",
      "file": "c020.ogg",
      "durationSec": 3.888
    },
    {
      "index": 21,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c021.ogg",
      "durationSec": 5.664
    },
    {
      "index": 22,
      "text": "指を小刻みに動かします。",
      "file": "c022.ogg",
      "durationSec": 5.232
    },
    {
      "index": 23,
      "text": "準備ができたら、目を開けてください。",
      "file": "c023.ogg",
      "durationSec": 5.976
    },
    {
      "index": 24,
      "text": "これを少しだけ持ち歩きましょう。",
      "file": "c024.ogg",
      "durationSec": 5.496
    }
  ]
}
