{
  "id": "coastal-walk-10",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 744,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "自分に何も求めない姿勢を見つけてください。",
      "file": "c001.ogg",
      "durationSec": 6.984
    },
    {
      "index": 2,
      "text": "必要なサポートを受けながら、座ったり、横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 10.032
    },
    {
      "index": 3,
      "text": "手を開いて、または柔らかく置いてください。",
      "file": "c003.ogg",
      "durationSec": 7.128
    },
    {
      "index": 4,
      "text": "目を閉じるか、優しい視線を保ちましょう。",
      "file": "c004.ogg",
      "durationSec": 7.176
    },
    {
      "index": 5,
      "text": "体と地面が接する場所を感じてください。",
      "file": "c005.ogg",
      "durationSec": 6.648
    },
    {
      "index": 6,
      "text": "かかと、座骨、後頭部、背骨の長さなどです。",
      "file": "c006.ogg",
      "durationSec": 9.048
    },
    {
      "index": 7,
      "text": "今のところ我慢できるものは何もありません。",
      "file": "c007.ogg",
      "durationSec": 6.816
    },
    {
      "index": 8,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c008.ogg",
      "durationSec": 5.52
    },
    {
      "index": 9,
      "text": "入ってくる空気の冷たさを感じてください。",
      "file": "c009.ogg",
      "durationSec": 6.864
    },
    {
      "index": 10,
      "text": "そして、少し長めに息を吐きます。",
      "file": "c010.ogg",
      "durationSec": 6.528
    },
    {
      "index": 11,
      "text": "出る呼気の温かさを感じてください。",
      "file": "c011.ogg",
      "durationSec": 6.072
    },
    {
      "index": 12,
      "text": "また。ソフトに吸い込みます。",
      "file": "c012.ogg",
      "durationSec": 6.552
    },
    {
      "index": 13,
      "text": "ゆっくりと息を吐きます。",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "肩を少し下げてみましょう。",
      "file": "c014.ogg",
      "durationSec": 5.016
    },
    {
      "index": 15,
      "text": "顎を緩めましょう。",
      "file": "c015.ogg",
      "durationSec": 3.936
    },
    {
      "index": 16,
      "text": "お腹を柔らかくしましょう。",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "そのままの状態で、静かな呼吸を 3 回続けてください。",
      "file": "c017.ogg",
      "durationSec": 9.144
    },
    {
      "index": 18,
      "text": "吸い込む。到着。",
      "file": "c018.ogg",
      "durationSec": 5.592
    },
    {
      "index": 19,
      "text": "息を吐きます。解決する。",
      "file": "c019.ogg",
      "durationSec": 6.648
    },
    {
      "index": 20,
      "text": "心がさまよったら、優しく気づいて、この呼吸に戻ってきてください。",
      "file": "c020.ogg",
      "durationSec": 10.584
    },
    {
      "index": 21,
      "text": "低い崖に沿った海岸沿いの小道をご覧ください。",
      "file": "c021.ogg",
      "durationSec": 7.632
    },
    {
      "index": 22,
      "text": "海は下で長く安定した回転をしながら呼吸しています。",
      "file": "c022.ogg",
      "durationSec": 8.76
    },
    {
      "index": 23,
      "text": "日光が頭頂部と鼻筋を温めます。",
      "file": "c023.ogg",
      "durationSec": 6.768
    },
    {
      "index": 24,
      "text": "潮風がまぶたを涼しく彩ってくれます。",
      "file": "c024.ogg",
      "durationSec": 6.792
    },
    {
      "index": 25,
      "text": "海の香り - ミネラル、クリーン、目覚め。",
      "file": "c025.ogg",
      "durationSec": 6.432
    },
    {
      "index": 26,
      "text": "あなたはゆっくり歩きます。草が風に吹かれて内陸に傾いています。",
      "file": "c026.ogg",
      "durationSec": 11.376
    },
    {
      "index": 27,
      "text": "片方の頬には太陽の光を感じ、もう片方の頬には冷たい空気を感じてください。",
      "file": "c027.ogg",
      "durationSec": 13.224
    },
    {
      "index": 28,
      "text": "そのコントラスト自体が一種の静けさです。",
      "file": "c028.ogg",
      "durationSec": 6.864
    },
    {
      "index": 29,
      "text": "木製の階段を下りると、隠れたビーチにたどり着きます。",
      "file": "c029.ogg",
      "durationSec": 8.76
    },
    {
      "index": 30,
      "text": "一つ一つのステップが確実です。あなたの手は風化したレールの上に置かれています。",
      "file": "c030.ogg",
      "durationSec": 13.248
    },
    {
      "index": 31,
      "text": "手のひらの下には温かみのある木。",
      "file": "c031.ogg",
      "durationSec": 6.336
    },
    {
      "index": 32,
      "text": "底では砂が柔らかいイエスのように足を受け止めます。",
      "file": "c032.ogg",
      "durationSec": 8.688
    },
    {
      "index": 33,
      "text": "波が白い線を書いたり消したりする場所まで歩いてください。",
      "file": "c033.ogg",
      "durationSec": 8.568
    },
    {
      "index": 34,
      "text": "冷たい水が足首にかかります。",
      "file": "c034.ogg",
      "durationSec": 5.952
    },
    {
      "index": 35,
      "text": "一歩下がったら、海岸のより高いところにある温かい砂が待っています。",
      "file": "c035.ogg",
      "durationSec": 10.704
    },
    {
      "index": 36,
      "text": "座る。太陽の光で温められた穀物に手を突っ込んでください。",
      "file": "c036.ogg",
      "durationSec": 11.496
    },
    {
      "index": 37,
      "text": "冷たい湿った砂の下に乾いた暖かさを感じてください。",
      "file": "c037.ogg",
      "durationSec": 8.88
    },
    {
      "index": 38,
      "text": "開いた水面に光が砕けるのを見てください。",
      "file": "c038.ogg",
      "durationSec": 7.248
    },
    {
      "index": 39,
      "text": "爽やかな風を吸い込んでください。",
      "file": "c039.ogg",
      "durationSec": 5.736
    },
    {
      "index": 40,
      "text": "肋骨にまだ残っている緊張感を息を吐き出します。",
      "file": "c040.ogg",
      "durationSec": 8.424
    },
    {
      "index": 41,
      "text": "カモメが一度鳴くと、静寂の一部になります。",
      "file": "c041.ogg",
      "durationSec": 7.728
    },
    {
      "index": 42,
      "text": "横になってください。目を閉じてください。",
      "file": "c042.ogg",
      "durationSec": 7.8
    },
    {
      "index": 43,
      "text": "目の前に広がる暖かさ。あなたのそばにクールな地球の影。",
      "file": "c043.ogg",
      "durationSec": 10.608
    },
    {
      "index": 44,
      "text": "潮のリズムがあなたの心を安らぎへと導きます。",
      "file": "c044.ogg",
      "durationSec": 8.16
    },
    {
      "index": 45,
      "text": "あなたは良い意味で小さいですが、大きくて優しいものに支えられています。",
      "file": "c045.ogg",
      "durationSec": 10.776
    },
    {
      "index": 46,
      "text": "閉じた目に太陽の暖かさを感じてください。",
      "file": "c046.ogg",
      "durationSec": 7.224
    },
    {
      "index": 47,
      "text": "風が変わっても、肌にスプレーの冷たいキスをしてください。",
      "file": "c047.ogg",
      "durationSec": 9.0
    },
    {
      "index": 48,
      "text": "平和は他の場所にあるわけではありません。それはこの岸、この息、この身体です。",
      "file": "c048.ogg",
      "durationSec": 14.232
    },
    {
      "index": 49,
      "text": "かかとを暖かい砂に少し深く掘ります。",
      "file": "c049.ogg",
      "durationSec": 7.176
    },
    {
      "index": 50,
      "text": "地球がしっかりと支えて応えてくれるのを感じてください。",
      "file": "c050.ogg",
      "durationSec": 7.968
    },
    {
      "index": 51,
      "text": "新鮮な塩を肺の底まで吸い込みましょう。",
      "file": "c051.ogg",
      "durationSec": 6.96
    },
    {
      "index": 52,
      "text": "衝撃に備えて息を吐き出します。",
      "file": "c052.ogg",
      "durationSec": 5.832
    },
    {
      "index": 53,
      "text": "ここでは影響はありません。波が到着してから到着するだけです。",
      "file": "c053.ogg",
      "durationSec": 11.04
    },
    {
      "index": 54,
      "text": "5 つの呼吸を患者の同じリズムに乗せます。",
      "file": "c054.ogg",
      "durationSec": 7.176
    },
    {
      "index": 55,
      "text": "その後、肌に残る太陽の光の中で休んでください。",
      "file": "c055.ogg",
      "durationSec": 9.048
    },
    {
      "index": 56,
      "text": "立ち上がって水線に沿って少し歩きます。",
      "file": "c056.ogg",
      "durationSec": 7.344
    },
    {
      "index": 57,
      "text": "左足は冷たくて濡れています。右足は暖かくて乾燥しています。それから切り替えます。",
      "file": "c057.ogg",
      "durationSec": 15.864
    },
    {
      "index": 58,
      "text": "体はコントラストを葛藤ではなく快適さとして学習します。",
      "file": "c058.ogg",
      "durationSec": 9.168
    },
    {
      "index": 59,
      "text": "光で温められた滑らかな石を手に取ります。",
      "file": "c059.ogg",
      "durationSec": 7.272
    },
    {
      "index": 60,
      "text": "手のひらでその熱を感じてください。その密度。静かです。",
      "file": "c060.ogg",
      "durationSec": 12.432
    },
    {
      "index": 61,
      "text": "感謝の気持ちを込めて置いておきます。保管しておく必要はありません。",
      "file": "c061.ogg",
      "durationSec": 11.088
    },
    {
      "index": 62,
      "text": "キープは内側にあります。",
      "file": "c062.ogg",
      "durationSec": 4.776
    },
    {
      "index": 63,
      "text": "ブレーカーの向こう側に目を向けると、落ち着いた色が見えます。",
      "file": "c063.ogg",
      "durationSec": 8.568
    },
    {
      "index": 64,
      "text": "青さを味わうかのように呼吸してください。",
      "file": "c064.ogg",
      "durationSec": 6.6
    },
    {
      "index": 65,
      "text": "爽やかな風。温かい頬。柔らかいお腹。",
      "file": "c065.ogg",
      "durationSec": 10.536
    },
    {
      "index": 66,
      "text": "次の息を最も深く吸う練習にしましょう。",
      "file": "c066.ogg",
      "durationSec": 7.224
    },
    {
      "index": 67,
      "text": "力を入れずに息を空にします。",
      "file": "c067.ogg",
      "durationSec": 5.832
    },
    {
      "index": 68,
      "text": "入り江、崖、家への道、すべてがプレッシャーを感じることなく待ちます。",
      "file": "c068.ogg",
      "durationSec": 10.896
    },
    {
      "index": 69,
      "text": "さて、物語は休んで、感覚を保ってください。",
      "file": "c069.ogg",
      "durationSec": 8.592
    },
    {
      "index": 70,
      "text": "この場所の新鮮さを吸い込んでください。",
      "file": "c070.ogg",
      "durationSec": 6.168
    },
    {
      "index": 71,
      "text": "その温かさと静けさの中に息を吐き出します。",
      "file": "c071.ogg",
      "durationSec": 7.848
    },
    {
      "index": 72,
      "text": "吸い込む。",
      "file": "c072.ogg",
      "durationSec": 2.88
    },
    {
      "index": 73,
      "text": "息を吐きます。",
      "file": "c073.ogg",
      "durationSec": 3.504
    },
    {
      "index": 74,
      "text": "また。ソフトに吸い込みます。",
      "file": "c074.ogg",
      "durationSec": 6.552
    },
    {
      "index": 75,
      "text": "息を長く吐く。",
      "file": "c075.ogg",
      "durationSec": 3.888
    },
    {
      "index": 76,
      "text": "この想像の世界の地面に身体が支えられているのを感じてください。",
      "file": "c076.ogg",
      "durationSec": 10.056
    },
    {
      "index": 77,
      "text": "吸い込む。",
      "file": "c077.ogg",
      "durationSec": 2.88
    },
    {
      "index": 78,
      "text": "息を吐きます。",
      "file": "c078.ogg",
      "durationSec": 3.504
    },
    {
      "index": 79,
      "text": "考えがさまよったら、皮膚の温もりに戻りましょう。",
      "file": "c079.ogg",
      "durationSec": 7.728
    },
    {
      "index": 80,
      "text": "あるいは鼻の空気を冷やすためです。",
      "file": "c080.ogg",
      "durationSec": 6.36
    },
    {
      "index": 81,
      "text": "吸い込む。",
      "file": "c081.ogg",
      "durationSec": 2.88
    },
    {
      "index": 82,
      "text": "息を吐きます。",
      "file": "c082.ogg",
      "durationSec": 3.504
    },
    {
      "index": 83,
      "text": "吸い込む。",
      "file": "c083.ogg",
      "durationSec": 2.88
    },
    {
      "index": 84,
      "text": "息を吐きます。",
      "file": "c084.ogg",
      "durationSec": 3.504
    },
    {
      "index": 85,
      "text": "滞在する。柔らかくする。続く。",
      "file": "c085.ogg",
      "durationSec": 9.192
    },
    {
      "index": 86,
      "text": "吸い込む。",
      "file": "c086.ogg",
      "durationSec": 2.88
    },
    {
      "index": 87,
      "text": "息を吐きます。",
      "file": "c087.ogg",
      "durationSec": 3.504
    },
    {
      "index": 88,
      "text": "もう 1 つの簡単なサイクル。",
      "file": "c088.ogg",
      "durationSec": 5.184
    },
    {
      "index": 89,
      "text": "吸い込む。",
      "file": "c089.ogg",
      "durationSec": 2.88
    },
    {
      "index": 90,
      "text": "息を吐きます。",
      "file": "c090.ogg",
      "durationSec": 3.504
    },
    {
      "index": 91,
      "text": "この感覚をもう少し呼吸してください。",
      "file": "c091.ogg",
      "durationSec": 6.384
    },
    {
      "index": 92,
      "text": "暖かさ。柔らかさ。十分です。",
      "file": "c092.ogg",
      "durationSec": 9.12
    },
    {
      "index": 93,
      "text": "必要なときにいつでもこの場所に戻ることができます。",
      "file": "c093.ogg",
      "durationSec": 7.872
    },
    {
      "index": 94,
      "text": "それは想像力の中だけではなく、あなたの注意力の中に生きています。",
      "file": "c094.ogg",
      "durationSec": 10.704
    },
    {
      "index": 95,
      "text": "呼吸を深め始めます。",
      "file": "c095.ogg",
      "durationSec": 4.584
    },
    {
      "index": 96,
      "text": "あなたの周りの部屋をもう一度感じてください。",
      "file": "c096.ogg",
      "durationSec": 7.008
    },
    {
      "index": 97,
      "text": "指を小刻みに動かします。つま先を柔らかくします。",
      "file": "c097.ogg",
      "durationSec": 9.936
    },
    {
      "index": 98,
      "text": "準備ができたら、目を開けてください。",
      "file": "c098.ogg",
      "durationSec": 5.976
    },
    {
      "index": 99,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c099.ogg",
      "durationSec": 5.664
    },
    {
      "index": 100,
      "text": "この平穏を次に何が起こっても持ち続けてください。",
      "file": "c100.ogg",
      "durationSec": 7.944
    }
  ]
}
