  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "快適な座席を見つけるか、気分が良い場合は横になってください。",
      "file": "c001.ogg",
      "durationSec": 9.816
    },
    {
      "index": 2,
      "text": "手を休めましょう。",
      "file": "c002.ogg",
      "durationSec": 3.888
    },
    {
      "index": 3,
      "text": "目を柔らかくするか、目を閉じてください。",
      "file": "c003.ogg",
      "durationSec": 6.648
    },
    {
      "index": 4,
      "text": "ゆっくりと息を吸い込みます。",
      "file": "c004.ogg",
      "durationSec": 5.016
    },
    {
      "index": 5,
      "text": "そして息を長く吐く。",
      "file": "c005.ogg",
      "durationSec": 4.656
    },
    {
      "index": 6,
      "text": "シンプルな箱の中で呼吸してみます。",
      "file": "c006.ogg",
      "durationSec": 6.024
    },
    {
      "index": 7,
      "text": "4人で入ります。 4 つ待ってください。 4人でアウト。 4 つ待ってください。",
      "file": "c007.ogg",
      "durationSec": 14.88
    },
    {
      "index": 8,
      "text": "優しくしてください。決して緊張しないでください。",
      "file": "c008.ogg",
      "durationSec": 8.976
    },
    {
      "index": 9,
      "text": "[休止:20]",
      "file": "c009.ogg",
      "durationSec": 3.48
    },
    {
      "index": 10,
      "text": "吸い込む。二。三つ。 4つ目。",
      "file": "c010.ogg",
      "durationSec": 9.984
    },
    {
      "index": 11,
      "text": "所有。二。三つ。 4つ目。",
      "file": "c011.ogg",
      "durationSec": 9.864
    },
    {
      "index": 12,
      "text": "息を吐きます。二。三つ。 4つ目。",
      "file": "c012.ogg",
      "durationSec": 10.608
    },
    {
      "index": 13,
      "text": "所有。二。三つ。 4つ目。",
