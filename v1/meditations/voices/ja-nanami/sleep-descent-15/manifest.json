  "totalSec": 206,
  "chunks": [
    {
      "index": 0,
      "text": "睡眠の練習へようこそ。",
      "file": "c000.ogg",
      "durationSec": 5.016
    },
    {
      "index": 1,
      "text": "横になる。暗闇を友達にしてください。",
      "file": "c001.ogg",
      "durationSec": 8.16
    },
    {
      "index": 2,
      "text": "終わる前に眠ってしまうかもしれません。それが成功です。",
      "file": "c002.ogg",
      "durationSec": 9.816
    },
    {
      "index": 3,
      "text": "[休止:22]",
      "file": "c003.ogg",
      "durationSec": 3.72
    },
    {
      "index": 4,
      "text": "ゆっくりと息を吸い込みます。",
      "file": "c004.ogg",
      "durationSec": 5.016
    },
    {
      "index": 5,
      "text": "息を長く吐く。",
      "file": "c005.ogg",
      "durationSec": 3.888
    },
    {
      "index": 6,
      "text": "[休止:22]",
      "file": "c006.ogg",
      "durationSec": 3.72
    },
    {
      "index": 7,
      "text": "額を解放します。",
      "file": "c007.ogg",
      "durationSec": 4.152
    },
    {
      "index": 8,
      "text": "[休止:18]",
      "file": "c008.ogg",
      "durationSec": 3.84
    },
    {
      "index": 9,
      "text": "目を放します。",
      "file": "c009.ogg",
      "durationSec": 3.6
    },
    {
      "index": 10,
      "text": "[休止:18]",
      "file": "c010.ogg",
      "durationSec": 3.84
    },
    {
      "index": 11,
      "text": "顎と舌を解放します。",
      "file": "c011.ogg",
      "durationSec": 4.776
    },
    {
      "index": 12,
      "text": "[休止:22]",
      "file": "c012.ogg",
      "durationSec": 3.72
    },
    {
      "index": 13,
      "text": "肩が溶ける。",
      "file": "c013.ogg",
      "durationSec": 3.288
    },
    {
      "index": 14,
      "text": "[休止:22]",
      "file": "c014.ogg",
      "durationSec": 3.72
    },
    {
      "index": 15,
      "text": "腕が重い。手を開きます。",
      "file": "c015.ogg",
      "durationSec": 6.528
    },
    {
      "index": 16,
      "text": "[休止:22]",
      "file": "c016.ogg",
      "durationSec": 3.72
    },
    {
      "index": 17,
      "text": "胸が柔らかい。お腹が柔らかい。",
      "file": "c017.ogg",
      "durationSec": 7.296
    },
    {
      "index": 18,
      "text": "[休止:22]",
      "file": "c018.ogg",
      "durationSec": 3.72
    },
    {
      "index": 19,
      "text": "腰が重い。",
      "file": "c019.ogg",
      "durationSec": 3.192
    },
    {
      "index": 20,
      "text": "[休止:22]",
      "file": "c020.ogg",
      "durationSec": 3.72
    },
    {
      "index": 21,
      "text": "足が重い。足が重い。",
      "file": "c021.ogg",
      "durationSec": 6.36
    },
    {
      "index": 22,
      "text": "[休止:27]",
      "file": "c022.ogg",
      "durationSec": 4.032
    },
    {
      "index": 23,
      "text": "体全体がベッドに沈み込みます。",
      "file": "c023.ogg",
      "durationSec": 5.952
    },
    {
      "index": 24,
      "text": "[休止:36]",
      "file": "c024.ogg",
      "durationSec": 4.608
    },
    {
      "index": 25,
      "text": "遠くの交通のような考え。",
      "file": "c025.ogg",
      "durationSec": 5.304
    },
    {
      "index": 26,
      "text": "あなたは彼らに従いません。",
      "file": "c026.ogg",
      "durationSec": 5.136
    },
    {
      "index": 27,
      "text": "[休止:45]",
      "file": "c027.ogg",
      "durationSec": 3.888
    },
    {
      "index": 28,
      "text": "呼吸が静かになります。",
      "file": "c028.ogg",
      "durationSec": 4.632
    },
    {
      "index": 29,
      "text": "[休止:45]",
      "file": "c029.ogg",
      "durationSec": 3.888
    },
    {
      "index": 30,
      "text": "より暗い。より柔らかく。もっとゆっくり。",
      "file": "c030.ogg",
      "durationSec": 9.72
    },
    {
      "index": 31,
      "text": "[休止:67]",
      "file": "c031.ogg",
      "durationSec": 4.656
    },
    {
      "index": 32,
      "text": "何も終わらせることはありません。",
      "file": "c032.ogg",
      "durationSec": 5.28
    },
    {
      "index": 33,
      "text": "[休止:54]",
      "file": "c033.ogg",
      "durationSec": 4.128
    },
    {
      "index": 34,
      "text": "安心して休めます。",
      "file": "c034.ogg",
      "durationSec": 4.392
    },
    {
      "index": 35,
      "text": "[休止:89]",
      "file": "c035.ogg",
      "durationSec": 4.608
    },
    {
      "index": 36,
      "text": "安心して眠れます。",
      "file": "c036.ogg",
      "durationSec": 4.296
    },
    {
      "index": 37,
      "text": "[休止:112]",
      "file": "c037.ogg",
      "durationSec": 4.32
    },
    {
      "index": 38,
      "text": "まだ目が覚めている場合は、息を吐きながら休み続けてください。",
      "file": "c038.ogg",
      "durationSec": 9.912
    },
    {
      "index": 39,
      "text": "[休止:89]",
      "file": "c039.ogg",
      "durationSec": 4.608
    },
    {
      "index": 40,
      "text": "おやすみ。",
      "file": "c040.ogg",
      "durationSec": 2.808
    },
    {
      "index": 41,
