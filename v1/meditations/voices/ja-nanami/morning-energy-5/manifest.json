{
  "id": "morning-energy-5",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 383,
  "chunks": [
    {
      "index": 0,
      "text": "おはよう。",
      "file": "c000.ogg",
      "durationSec": 2.808
    },
    {
      "index": 1,
      "text": "その日を迎えるための短い練習へようこそ。",
      "file": "c001.ogg",
      "durationSec": 7.32
    },
    {
      "index": 2,
      "text": "背筋を伸ばして座るか、その方が気分が良い場合は立ってください。",
      "file": "c002.ogg",
      "durationSec": 9.912
    },
    {
      "index": 3,
      "text": "目を柔らかくするか、目を閉じてください。",
      "file": "c003.ogg",
      "durationSec": 6.648
    },
    {
      "index": 4,
      "text": "足が床に着いているのを感じてください。",
      "file": "c004.ogg",
      "durationSec": 6.408
    },
    {
      "index": 5,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c005.ogg",
      "durationSec": 5.52
    },
    {
      "index": 6,
      "text": "そして口からさらに豊かな息を吐き出します。",
      "file": "c006.ogg",
      "durationSec": 7.224
    },
    {
      "index": 7,
      "text": "また。ソフトに吸い込みます。",
      "file": "c007.ogg",
      "durationSec": 6.552
    },
    {
      "index": 8,
      "text": "完全に吐き出します。",
      "file": "c008.ogg",
      "durationSec": 4.296
    },
    {
      "index": 9,
      "text": "もう一つ。胸をいっぱいにしてください。",
      "file": "c009.ogg",
      "durationSec": 7.728
    },
    {
      "index": 10,
      "text": "完全に空です。",
      "file": "c010.ogg",
      "durationSec": 3.888
    },
    {
      "index": 11,
      "text": "[休止:4]",
      "file": "c011.ogg",
      "durationSec": 3.36
    },
    {
      "index": 12,
      "text": "掴まずにその日を見据えてください。",
      "file": "c012.ogg",
      "durationSec": 5.808
    },
    {
      "index": 13,
      "text": "マップ全体はまだ必要ありません。",
      "file": "c013.ogg",
      "durationSec": 6.0
    },
    {
      "index": 14,
      "text": "次の正直なステップです。",
      "file": "c014.ogg",
      "durationSec": 4.992
    },
    {
      "index": 15,
      "text": "[休止:5]",
      "file": "c015.ogg",
      "durationSec": 3.696
    },
    {
      "index": 16,
      "text": "4人で息を吸います。",
      "file": "c016.ogg",
      "durationSec": 4.416
    },
    {
      "index": 17,
      "text": "二。三つ。 4つ目。",
      "file": "c017.ogg",
      "durationSec": 7.248
    },
    {
      "index": 18,
      "text": "4人で息を吐きます。",
      "file": "c018.ogg",
      "durationSec": 4.392
    },
    {
      "index": 19,
      "text": "二。三つ。 4つ目。",
      "file": "c019.ogg",
      "durationSec": 7.248
    },
    {
      "index": 20,
      "text": "繰り返しますが、自分のペースで。",
      "file": "c020.ogg",
      "durationSec": 6.024
    },
    {
      "index": 21,
      "text": "[休止:6]",
      "file": "c021.ogg",
      "durationSec": 3.912
    },
    {
      "index": 22,
      "text": "手に温もりを感じてください。",
      "file": "c022.ogg",
      "durationSec": 5.136
    },
    {
      "index": 23,
      "text": "脚の準備ができているのを感じます。",
      "file": "c023.ogg",
      "durationSec": 5.808
    },
    {
      "index": 24,
      "text": "[休止:4]",
      "file": "c024.ogg",
      "durationSec": 3.36
    },
    {
      "index": 25,
      "text": "肩を上、後ろ、下に回します。",
      "file": "c025.ogg",
      "durationSec": 6.36
    },
    {
      "index": 26,
      "text": "顎を緩めます。",
      "file": "c026.ogg",
      "durationSec": 3.696
    },
    {
      "index": 27,
      "text": "お腹を柔らかくする。",
      "file": "c027.ogg",
      "durationSec": 4.344
    },
    {
      "index": 28,
      "text": "体内に残っている睡眠に注目してください。",
      "file": "c028.ogg",
      "durationSec": 7.152
    },
    {
      "index": 29,
      "text": "押しのける必要はありません。",
      "file": "c029.ogg",
      "durationSec": 4.968
    },
    {
      "index": 30,
      "text": "肋骨の側面に息を吹き込みます。",
      "file": "c030.ogg",
      "durationSec": 6.264
    },
    {
      "index": 31,
      "text": "そして、息を吐きながら幅を狭めましょう。",
      "file": "c031.ogg",
      "durationSec": 7.296
    },
    {
      "index": 32,
      "text": "[休止:5]",
      "file": "c032.ogg",
      "durationSec": 3.696
    },
    {
      "index": 33,
      "text": "今度は息に少し明るさをもたらします。",
      "file": "c033.ogg",
      "durationSec": 6.624
    },
    {
      "index": 34,
      "text": "内側から目覚めるかのように息を吸います。",
      "file": "c034.ogg",
      "durationSec": 6.792
    },
    {
      "index": 35,
      "text": "昨日の重いものを吐き出します。",
      "file": "c035.ogg",
      "durationSec": 5.232
    },
    {
      "index": 36,
      "text": "吸入の可能性。",
      "file": "c036.ogg",
      "durationSec": 4.176
    },
    {
      "index": 37,
      "text": "まだ必要のない力を吐き出します。",
      "file": "c037.ogg",
      "durationSec": 6.024
    },
    {
      "index": 38,
      "text": "[休止:4]",
      "file": "c038.ogg",
      "durationSec": 3.36
    },
    {
      "index": 39,
      "text": "心臓に手を置くか、両手を膝の上に置きます。",
      "file": "c039.ogg",
      "durationSec": 7.776
    },
    {
      "index": 40,
      "text": "黙って、またはただ聞いて、これらのフレーズを試してみてください。",
      "file": "c040.ogg",
      "durationSec": 9.936
    },
    {
      "index": 41,
      "text": "私はここにいます。",
      "file": "c041.ogg",
      "durationSec": 4.224
    },
    {
      "index": 42,
      "text": "また始めます。",
      "file": "c042.ogg",
      "durationSec": 3.648
    },
    {
      "index": 43,
      "text": "今朝はもう十分です。",
      "file": "c043.ogg",
      "durationSec": 4.392
    },
    {
      "index": 44,
      "text": "[休止:4]",
      "file": "c044.ogg",
      "durationSec": 3.36
    },
    {
      "index": 45,
      "text": "安定して動きます。",
      "file": "c045.ogg",
      "durationSec": 4.128
    },
    {
      "index": 46,
      "text": "澄んだ心でやってくるものに出会う。",
      "file": "c046.ogg",
      "durationSec": 5.784
    },
    {
      "index": 47,
      "text": "本日はスペースをとらせていただきます。",
      "file": "c047.ogg",
      "durationSec": 6.432
    },
    {
      "index": 48,
      "text": "[休止:5]",
      "file": "c048.ogg",
      "durationSec": 3.696
    },
    {
      "index": 49,
      "text": "今日は明確な意図を 1 つ選びます。",
      "file": "c049.ogg",
      "durationSec": 6.024
    },
    {
      "index": 50,
      "text": "シンプルなことでも構いません。",
      "file": "c050.ogg",
      "durationSec": 5.16
    },
    {
      "index": 51,
      "text": "親切。集中。忍耐。エネルギー。",
      "file": "c051.ogg",
      "durationSec": 11.304
    },
    {
      "index": 52,
      "text": "その言葉を一呼吸置いてください。",
      "file": "c052.ogg",
      "durationSec": 6.0
    },
    {
      "index": 53,
      "text": "[休止:6]",
      "file": "c053.ogg",
      "durationSec": 3.912
    },
    {
      "index": 54,
      "text": "そのような姿勢で朝を過ごしている自分を見てください。",
      "file": "c054.ogg",
      "durationSec": 8.496
    },
    {
      "index": 55,
      "text": "[休止:5]",
      "file": "c055.ogg",
      "durationSec": 3.696
    },
    {
      "index": 56,
      "text": "[休止:5]",
      "file": "c056.ogg",
      "durationSec": 3.696
    },
    {
      "index": 57,
      "text": "指を広く、そして柔らかく伸ばします。",
      "file": "c057.ogg",
      "durationSec": 7.056
    },
    {
      "index": 58,
      "text": "本当だと感じたら、口角を少しだけ上げてください。",
      "file": "c058.ogg",
      "durationSec": 8.304
    },
    {
      "index": 59,
      "text": "[休止:3]",
      "file": "c059.ogg",
      "durationSec": 3.552
    },
    {
      "index": 60,
      "text": "次に息を吸い込むときに背骨が伸びるのを感じてください。",
      "file": "c060.ogg",
      "durationSec": 8.88
    },
    {
      "index": 61,
      "text": "息を吐きながら肩が落ち着くのを感じてください。",
      "file": "c061.ogg",
      "durationSec": 7.488
    },
    {
      "index": 62,
      "text": "もう一度明るい息を吸い込みます。",
      "file": "c062.ogg",
      "durationSec": 5.808
    },
    {
      "index": 63,
      "text": "そして、長く楽に息を吐きます。",
      "file": "c063.ogg",
      "durationSec": 6.336
    },
    {
      "index": 64,
      "text": "指を小刻みに動かします。",
      "file": "c064.ogg",
      "durationSec": 5.232
    },
    {
      "index": 65,
      "text": "準備ができたら、目を開けてください。",
      "file": "c065.ogg",
      "durationSec": 5.976
    },
    {
      "index": 66,
      "text": "この静かなエネルギーを毎日に取り入れてください。",
      "file": "c066.ogg",
      "durationSec": 7.512
    }
  ]
}
