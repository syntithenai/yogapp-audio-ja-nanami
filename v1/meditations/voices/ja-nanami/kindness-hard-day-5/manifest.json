{
  "id": "kindness-hard-day-5",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 152,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "快適な座席を見つけるか、気分が良い場合は横になってください。",
      "file": "c001.ogg",
      "durationSec": 9.816
    },
    {
      "index": 2,
      "text": "手を休めましょう。",
      "file": "c002.ogg",
      "durationSec": 3.888
    },
    {
      "index": 3,
      "text": "目を柔らかくするか、目を閉じてください。",
      "file": "c003.ogg",
      "durationSec": 6.648
    },
    {
      "index": 4,
      "text": "ゆっくりと息を吸い込みます。",
      "file": "c004.ogg",
      "durationSec": 5.016
    },
    {
      "index": 5,
      "text": "そして息を長く吐く。",
      "file": "c005.ogg",
      "durationSec": 4.656
    },
    {
      "index": 6,
      "text": "簡単だったふりをする必要はありません。",
      "file": "c006.ogg",
      "durationSec": 6.288
    },
    {
      "index": 7,
      "text": "疲れという真実を受け入れましょう。",
      "file": "c007.ogg",
      "durationSec": 5.808
    },
    {
      "index": 8,
      "text": "[休止:31]",
      "file": "c008.ogg",
      "durationSec": 4.632
    },
    {
      "index": 9,
      "text": "気を付けて呼吸してください。",
      "file": "c009.ogg",
      "durationSec": 4.92
    },
    {
      "index": 10,
      "text": "元気になりたいという要求を吐き出しましょう。",
      "file": "c010.ogg",
      "durationSec": 6.792
    },
    {
      "index": 11,
      "text": "[休止:31]",
      "file": "c011.ogg",
      "durationSec": 4.632
    },
    {
      "index": 12,
      "text": "今夜は自分に優しくできますように。",
      "file": "c012.ogg",
      "durationSec": 6.264
    },
    {
      "index": 13,
      "text": "このままで休んでもいいですか。",
      "file": "c013.ogg",
      "durationSec": 5.136
    },
    {
      "index": 14,
      "text": "[休止:31]",
      "file": "c014.ogg",
      "durationSec": 4.632
    },
    {
      "index": 15,
      "text": "明日は私が与えられるものだけを求めてください。",
      "file": "c015.ogg",
      "durationSec": 7.608
    },
    {
      "index": 16,
      "text": "[休止:31]",
      "file": "c016.ogg",
      "durationSec": 4.632
    },
    {
      "index": 17,
      "text": "身体が支えられているのを感じてください。",
      "file": "c017.ogg",
      "durationSec": 6.576
    },
    {
      "index": 18,
      "text": "この分ではこれ以上何も必要ありません。",
      "file": "c018.ogg",
      "durationSec": 6.912
    },
    {
      "index": 19,
      "text": "[休止:45]",
      "file": "c019.ogg",
      "durationSec": 3.888
    },
    {
      "index": 20,
      "text": "それが助けになるなら、心に手を当ててください。",
      "file": "c020.ogg",
      "durationSec": 7.872
    },
    {
      "index": 21,
      "text": "あなたはそれをやり遂げました。",
      "file": "c021.ogg",
      "durationSec": 5.232
    },
    {
      "index": 22,
      "text": "[休止:38]",
      "file": "c022.ogg",
      "durationSec": 4.608
    },
    {
      "index": 23,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c023.ogg",
      "durationSec": 5.664
    },
    {
      "index": 24,
      "text": "指を小刻みに動かします。",
      "file": "c024.ogg",
      "durationSec": 5.232
    },
    {
      "index": 25,
      "text": "準備ができたら、目を開けてください。",
      "file": "c025.ogg",
      "durationSec": 5.976
    },
    {
      "index": 26,
      "text": "これを少しだけ持ち歩きましょう。",
      "file": "c026.ogg",
      "durationSec": 5.496
    }
  ]
}
