{
  "id": "meadow-breeze-5",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 410,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "快適な座席に座るか、気分が良い場合は横になってください。",
      "file": "c001.ogg",
      "durationSec": 9.72
    },
    {
      "index": 2,
      "text": "手を休めましょう。",
      "file": "c002.ogg",
      "durationSec": 3.888
    },
    {
      "index": 3,
      "text": "目を閉じるか、視線を和らげてください。",
      "file": "c003.ogg",
      "durationSec": 6.744
    },
    {
      "index": 4,
      "text": "身体が支えられている重さに注目してください。",
      "file": "c004.ogg",
      "durationSec": 7.536
    },
    {
      "index": 5,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c005.ogg",
      "durationSec": 5.52
    },
    {
      "index": 6,
      "text": "そして長く楽に息を吐くことができます。",
      "file": "c006.ogg",
      "durationSec": 6.984
    },
    {
      "index": 7,
      "text": "また。ソフトに吸い込みます。",
      "file": "c007.ogg",
      "durationSec": 6.552
    },
    {
      "index": 8,
      "text": "ゆっくりと息を吐きます。",
      "file": "c008.ogg",
      "durationSec": 4.584
    },
    {
      "index": 9,
      "text": "考えがさまよっても、それは問題ありません。呼吸に戻ります。",
      "file": "c009.ogg",
      "durationSec": 10.824
    },
    {
      "index": 10,
      "text": "深夜の広い山の牧草地を想像してみてください。",
      "file": "c010.ogg",
      "durationSec": 7.872
    },
    {
      "index": 11,
      "text": "背の高い草が穏やかな波に揺れる。",
      "file": "c011.ogg",
      "durationSec": 6.384
    },
    {
      "index": 12,
      "text": "日差しは鋭くなく暖かいです。",
      "file": "c012.ogg",
      "durationSec": 5.64
    },
    {
      "index": 13,
      "text": "優しくて安定した気持ちを頭頂部で感じてください。",
      "file": "c013.ogg",
      "durationSec": 8.136
    },
    {
      "index": 14,
      "text": "爽やかな風が草を抜けてあなたの顔を見つけます。",
      "file": "c014.ogg",
      "durationSec": 8.28
    },
    {
      "index": 15,
      "text": "野の花と天日で乾いた土の香りがします。",
      "file": "c015.ogg",
      "durationSec": 7.44
    },
    {
      "index": 16,
      "text": "あなたはゆっくりと歩き、指先で種子の頭を撫でます。",
      "file": "c016.ogg",
      "durationSec": 8.736
    },
    {
      "index": 17,
      "text": "ソフトなくすぐり。柔らかい音。",
      "file": "c017.ogg",
      "durationSec": 7.248
    },
    {
      "index": 18,
      "text": "蝶はゆっくりと舞い上がり、再び落ち着きます。",
      "file": "c018.ogg",
      "durationSec": 7.416
    },
    {
      "index": 19,
      "text": "あなたは草の中に横たわる場所を見つけます。",
      "file": "c019.ogg",
      "durationSec": 7.176
    },
    {
      "index": 20,
      "text": "地球はあなたの全長を支えます。",
      "file": "c020.ogg",
      "durationSec": 6.144
    },
    {
      "index": 21,
      "text": "前面に沿った暖かさ。脇に涼しい土の影。",
      "file": "c021.ogg",
      "durationSec": 9.6
    },
    {
      "index": 22,
      "text": "風は優しい潮の流れのように去ったり来たりします。",
      "file": "c022.ogg",
      "durationSec": 7.92
    },
    {
      "index": 23,
      "text": "新鮮さを吸い込みます。広々とした空に息を吐き出しましょう。",
      "file": "c023.ogg",
      "durationSec": 11.136
    },
    {
      "index": 24,
      "text": "雲が一瞬太陽の上を横切ります。",
      "file": "c024.ogg",
      "durationSec": 6.312
    },
    {
      "index": 25,
      "text": "涼しさ。すると顔に温かさが戻ってきます。",
      "file": "c025.ogg",
      "durationSec": 8.928
    },
    {
      "index": 26,
      "text": "静けさがどれほど大きく感じられるかに注目してください。",
      "file": "c026.ogg",
      "durationSec": 8.76
    },
    {
      "index": 27,
      "text": "この広い分野では、どんな心配もどれほど小さなものに見えるでしょう。",
      "file": "c027.ogg",
      "durationSec": 10.32
    },
    {
      "index": 28,
      "text": "手を草の中に置きます。小さな茎が優しく押します。",
      "file": "c028.ogg",
      "durationSec": 9.744
    },
    {
      "index": 29,
      "text": "閉じた目に太陽の暖かさを感じてください。",
      "file": "c029.ogg",
      "durationSec": 7.224
    },
    {
      "index": 30,
      "text": "草を腕に軽く押し当てるようにしてください。",
      "file": "c030.ogg",
      "durationSec": 6.648
    },
    {
      "index": 31,
      "text": "あなたはこのままでいられるのです。",
      "file": "c031.ogg",
      "durationSec": 5.424
    },
    {
      "index": 32,
      "text": "さらに数サイクル、牧草地に息を吹き込みましょう。",
      "file": "c032.ogg",
      "durationSec": 8.232
    },
    {
      "index": 33,
      "text": "温かい頭頂部から注意を向けてください",
      "file": "c033.ogg",
      "durationSec": 6.96
    },
    {
      "index": 34,
      "text": "柔らかい顔、柔らかい喉を通して、",
      "file": "c034.ogg",
      "durationSec": 6.528
    },
    {
      "index": 35,
      "text": "大空の下、軽やかに盛り上がる胸に。",
      "file": "c035.ogg",
      "durationSec": 6.816
    },
    {
      "index": 36,
      "text": "風があなたの手首の内側を見つけます。",
      "file": "c036.ogg",
      "durationSec": 6.432
    },
    {
      "index": 37,
      "text": "いいね。生きている。フレンドリー。",
      "file": "c037.ogg",
      "durationSec": 8.472
    },
    {
      "index": 38,
      "text": "どこかでミツバチは緊急性を持たずに働いています。",
      "file": "c038.ogg",
      "durationSec": 8.136
    },
    {
      "index": 39,
      "text": "彼らのハム音はまた別の種類の静けさです。",
      "file": "c039.ogg",
      "durationSec": 7.752
    },
    {
      "index": 40,
      "text": "暖かさと新鮮さが1つの生地のように感じられるまで滞在してください。",
      "file": "c040.ogg",
      "durationSec": 10.896
    },
    {
      "index": 41,
      "text": "それでは、少しの間、一人で呼吸の中で休んでください。",
      "file": "c041.ogg",
      "durationSec": 9.72
    },
    {
      "index": 42,
      "text": "ゆっくりと吸い込みます。",
      "file": "c042.ogg",
      "durationSec": 4.368
    },
    {
      "index": 43,
      "text": "ゆっくりと息を吐きます。",
      "file": "c043.ogg",
      "durationSec": 4.584
    },
    {
      "index": 44,
      "text": "吸い込む。",
      "file": "c044.ogg",
      "durationSec": 2.88
    },
    {
      "index": 45,
      "text": "息を吐きます。",
      "file": "c045.ogg",
      "durationSec": 3.504
    },
    {
      "index": 46,
      "text": "体が温かいところはどこでも温かさを感じます。",
      "file": "c046.ogg",
      "durationSec": 8.256
    },
    {
      "index": 47,
      "text": "空気が冷たければどこでも涼しさを感じます。",
      "file": "c047.ogg",
      "durationSec": 7.344
    },
    {
      "index": 48,
      "text": "吸い込む。",
      "file": "c048.ogg",
      "durationSec": 2.88
    },
    {
      "index": 49,
      "text": "息を吐きます。",
      "file": "c049.ogg",
      "durationSec": 3.504
    },
    {
      "index": 50,
      "text": "どこにも行くところがない。修正するものは何もありません。",
      "file": "c050.ogg",
      "durationSec": 9.84
    },
    {
      "index": 51,
      "text": "吸い込む。",
      "file": "c051.ogg",
      "durationSec": 2.88
    },
    {
      "index": 52,
      "text": "息を吐きます。",
      "file": "c052.ogg",
      "durationSec": 3.504
    },
    {
      "index": 53,
      "text": "ここで数回静かに呼吸してください。",
      "file": "c053.ogg",
      "durationSec": 6.24
    },
    {
      "index": 54,
      "text": "いつでもこの場所に戻れることを知っておいてください。",
      "file": "c054.ogg",
      "durationSec": 7.44
    },
    {
      "index": 55,
      "text": "準備ができたら、呼吸を深めてください。",
      "file": "c055.ogg",
      "durationSec": 6.648
    },
    {
      "index": 56,
      "text": "指や足の指を小刻みに動かします。",
      "file": "c056.ogg",
      "durationSec": 6.84
    },
    {
      "index": 57,
      "text": "そっと目を開けてください。",
      "file": "c057.ogg",
      "durationSec": 4.536
    },
    {
      "index": 58,
      "text": "この平和を少しでも持ち歩きましょう。",
      "file": "c058.ogg",
      "durationSec": 6.24
    }
  ]
}
