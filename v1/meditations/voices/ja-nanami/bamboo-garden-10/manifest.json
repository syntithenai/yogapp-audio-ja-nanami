{
  "id": "bamboo-garden-10",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 752,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "自分に何も求めない姿勢を見つけてください。",
      "file": "c001.ogg",
      "durationSec": 6.984
    },
    {
      "index": 2,
      "text": "必要なサポートを受けながら、座ったり、横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 10.032
    },
    {
      "index": 3,
      "text": "手を開いて、または柔らかく置いてください。",
      "file": "c003.ogg",
      "durationSec": 7.128
    },
    {
      "index": 4,
      "text": "目を閉じるか、優しい視線を保ちましょう。",
      "file": "c004.ogg",
      "durationSec": 7.176
    },
    {
      "index": 5,
      "text": "体と地面が接する場所を感じてください。",
      "file": "c005.ogg",
      "durationSec": 6.648
    },
    {
      "index": 6,
      "text": "かかと、座骨、後頭部、背骨の長さなどです。",
      "file": "c006.ogg",
      "durationSec": 9.048
    },
    {
      "index": 7,
      "text": "今のところ我慢できるものは何もありません。",
      "file": "c007.ogg",
      "durationSec": 6.816
    },
    {
      "index": 8,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c008.ogg",
      "durationSec": 5.52
    },
    {
      "index": 9,
      "text": "入ってくる空気の冷たさを感じてください。",
      "file": "c009.ogg",
      "durationSec": 6.864
    },
    {
      "index": 10,
      "text": "そして、少し長めに息を吐きます。",
      "file": "c010.ogg",
      "durationSec": 6.528
    },
    {
      "index": 11,
      "text": "出る呼気の温かさを感じてください。",
      "file": "c011.ogg",
      "durationSec": 6.072
    },
    {
      "index": 12,
      "text": "また。ソフトに吸い込みます。",
      "file": "c012.ogg",
      "durationSec": 6.552
    },
    {
      "index": 13,
      "text": "ゆっくりと息を吐きます。",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "肩を少し下げてみましょう。",
      "file": "c014.ogg",
      "durationSec": 5.016
    },
    {
      "index": 15,
      "text": "顎を緩めましょう。",
      "file": "c015.ogg",
      "durationSec": 3.936
    },
    {
      "index": 16,
      "text": "お腹を柔らかくしましょう。",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "そのままの状態で、静かな呼吸を 3 回続けてください。",
      "file": "c017.ogg",
      "durationSec": 9.144
    },
    {
      "index": 18,
      "text": "吸い込む。到着。",
      "file": "c018.ogg",
      "durationSec": 5.592
    },
    {
      "index": 19,
      "text": "息を吐きます。解決する。",
      "file": "c019.ogg",
      "durationSec": 6.648
    },
    {
      "index": 20,
      "text": "心がさまよったら、優しく気づいて、この呼吸に戻ってきてください。",
      "file": "c020.ogg",
      "durationSec": 10.584
    },
    {
      "index": 21,
      "text": "雨上がりの竹庭を想像してみてください。",
      "file": "c021.ogg",
      "durationSec": 6.552
    },
    {
      "index": 22,
      "text": "石は暗くてきれいです。葉っぱが光ります。",
      "file": "c022.ogg",
      "durationSec": 8.352
    },
    {
      "index": 23,
      "text": "涼しい爽やかさが柔らかい鐘のように空気を満たします。",
      "file": "c023.ogg",
      "durationSec": 8.784
    },
    {
      "index": 24,
      "text": "雲の切れ目から太陽の光が差し込みます。",
      "file": "c024.ogg",
      "durationSec": 7.08
    },
    {
      "index": 25,
      "text": "額や頬骨に突然の優しい温かさを感じます。",
      "file": "c025.ogg",
      "durationSec": 8.424
    },
    {
      "index": 26,
      "text": "道からかすかに蒸気が立ち上り、大地が息を吐き出します。",
      "file": "c026.ogg",
      "durationSec": 9.432
    },
    {
      "index": 27,
      "text": "苔の中に設置された飛び石を踏みます。",
      "file": "c027.ogg",
      "durationSec": 6.624
    },
    {
      "index": 28,
      "text": "どの石も足元がひんやりと確かです。",
      "file": "c028.ogg",
      "durationSec": 6.672
    },
    {
      "index": 29,
      "text": "竹がきしみ、そよ風にささやきます。",
      "file": "c029.ogg",
      "durationSec": 6.576
    },
    {
      "index": 30,
      "text": "音は緑色です。音は穏やかです。",
      "file": "c030.ogg",
      "durationSec": 7.992
    },
    {
      "index": 31,
      "text": "濡れた葉、石、そして近くにある茶木のほのかな甘みの香り。",
      "file": "c031.ogg",
      "durationSec": 9.408
    },
    {
      "index": 32,
      "text": "小さな池の横で休憩。",
      "file": "c032.ogg",
      "durationSec": 5.016
    },
    {
      "index": 33,
      "text": "鯉は水面下でゆっくりとした思考のように動きます。",
      "file": "c033.ogg",
      "durationSec": 7.8
    },
    {
      "index": 34,
      "text": "手すりの上に手首を置くと、太陽の光が手首を温めます。",
      "file": "c034.ogg",
      "durationSec": 9.816
    },
    {
      "index": 35,
      "text": "風がこめかみの湿気を冷やしてくれます。",
      "file": "c035.ogg",
      "durationSec": 6.432
    },
    {
      "index": 36,
      "text": "新鮮さを取り入れ、柔らかさを出していきます。",
      "file": "c036.ogg",
      "durationSec": 7.512
    },
    {
      "index": 37,
      "text": "磨耗した木の屋根付きの歩道を進みます。",
      "file": "c037.ogg",
      "durationSec": 6.528
    },
    {
      "index": 38,
      "text": "ボードは日陰では涼しく、光が当たる場所では暖かくなります。",
      "file": "c038.ogg",
      "durationSec": 10.056
    },
    {
      "index": 39,
      "text": "あなたはかき集められた砂利と 1 つの完璧な石に面してベンチに座っています。",
      "file": "c039.ogg",
      "durationSec": 10.968
    },
    {
      "index": 40,
      "text": "何も並べ替える必要はありません。",
      "file": "c040.ogg",
      "durationSec": 5.88
    },
    {
      "index": 41,
      "text": "静かな幾何学模様が心を落ち着かせてくれるのを感じてください。",
      "file": "c041.ogg",
      "durationSec": 9.552
    },
    {
      "index": 42,
      "text": "雲が薄くなるにつれて暖かさが戻ってきます。肩に優しい手が添えられます。",
      "file": "c042.ogg",
      "durationSec": 12.864
    },
    {
      "index": 43,
      "text": "その後、再び日陰になり、涼しく休息します。",
      "file": "c043.ogg",
      "durationSec": 8.52
    },
    {
      "index": 44,
      "text": "想像上のお茶を飲みます。温もりを味わう。カップの熱を手のひらで感じてください。",
      "file": "c044.ogg",
      "durationSec": 14.88
    },
    {
      "index": 45,
      "text": "庭の外でも生活は続きます。中では時間が緩みます。",
      "file": "c045.ogg",
      "durationSec": 10.728
    },
    {
      "index": 46,
      "text": "もう一度竹の下を歩きます。",
      "file": "c046.ogg",
      "durationSec": 5.352
    },
    {
      "index": 47,
      "text": "背の高い茎に息を揺らして、同じ楽なリズムを刻んでください。",
      "file": "c047.ogg",
      "durationSec": 10.056
    },
    {
      "index": 48,
      "text": "葉っぱから落ちる冷たい滴が手首に届きます。ちょっとした新鮮な驚きです。",
      "file": "c048.ogg",
      "durationSec": 13.008
    },
    {
      "index": 49,
      "text": "その後、もう一度日光に当て、同じ場所を乾くまで温めます。",
      "file": "c049.ogg",
      "durationSec": 10.44
    },
    {
      "index": 50,
      "text": "あなたが滞在している限り、あなたはこの平和に属しています。",
      "file": "c050.ogg",
      "durationSec": 9.624
    },
    {
      "index": 51,
      "text": "そして、その糸はあなたが去るときに持ってきます。",
      "file": "c051.ogg",
      "durationSec": 8.352
    },
    {
      "index": 52,
      "text": "もう一度座ってください。手は膝の上で開きます。",
      "file": "c052.ogg",
      "durationSec": 9.288
    },
    {
      "index": 53,
      "text": "光が当たるところはどこでも暖かさ。竹陰の涼しさ。",
      "file": "c053.ogg",
      "durationSec": 10.176
    },
    {
      "index": 54,
      "text": "雨上がりの爽やかさを吸い込みます。",
      "file": "c054.ogg",
      "durationSec": 6.0
    },
    {
      "index": 55,
      "text": "石と砂利のかき集められた静寂の中に息を吐き出します。",
      "file": "c055.ogg",
      "durationSec": 9.0
    },
    {
      "index": 56,
      "text": "鋭いものは何も残りません。ソフトエッジと十分な空気のみ。",
      "file": "c056.ogg",
      "durationSec": 10.968
    },
    {
      "index": 57,
      "text": "池に戻って最後の休憩。",
      "file": "c057.ogg",
      "durationSec": 5.376
    },
    {
      "index": 58,
      "text": "落ちた雫の波紋が広がって消えていく。",
      "file": "c058.ogg",
      "durationSec": 6.504
    },
    {
      "index": 59,
      "text": "太陽の斑点が踊り、そして静止。",
      "file": "c059.ogg",
      "durationSec": 6.864
    },
    {
      "index": 60,
      "text": "頬骨に伝わる温かさ。鼻に残る涼しい霧の記憶。",
      "file": "c060.ogg",
      "durationSec": 10.512
    },
    {
      "index": 61,
      "text": "庭に向かって軽くお辞儀をし、内向きに小さくうなずきます。",
      "file": "c061.ogg",
      "durationSec": 9.384
    },
    {
      "index": 62,
      "text": "先ほどよりもゆっくりともう一度飛び石を歩きます。",
      "file": "c062.ogg",
      "durationSec": 8.16
    },
    {
      "index": 63,
      "text": "石の間にひんやりとした苔。温かみのある木製の橋レール。",
      "file": "c063.ogg",
      "durationSec": 11.016
    },
    {
      "index": 64,
      "text": "竹は頭上で葉っぱの言葉を話します。",
      "file": "c064.ogg",
      "durationSec": 6.552
    },
    {
      "index": 65,
      "text": "あなたはそれを十分に理解しています：留まり、和らげ、継続してください。",
      "file": "c065.ogg",
      "durationSec": 11.736
    },
    {
      "index": 66,
      "text": "入り口で、庭園の平和と日常の両方の世界を感じてください。",
      "file": "c066.ogg",
      "durationSec": 10.152
    },
    {
      "index": 67,
      "text": "三つ編みにしてもいいでしょう。",
      "file": "c067.ogg",
      "durationSec": 4.728
    },
    {
      "index": 68,
      "text": "三つ編みに新鮮さを吸い込みます。",
      "file": "c068.ogg",
      "durationSec": 6.072
    },
    {
      "index": 69,
      "text": "手に温もりを吐き出し、何が起こるかに備える準備を整えてください。",
      "file": "c069.ogg",
      "durationSec": 10.176
    },
    {
      "index": 70,
      "text": "見ようが見まいが、庭園は残ります。",
      "file": "c070.ogg",
      "durationSec": 6.24
    },
    {
      "index": 71,
      "text": "さて、物語は休んで、感覚を保ってください。",
      "file": "c071.ogg",
      "durationSec": 8.592
    },
    {
      "index": 72,
      "text": "この場所の新鮮さを吸い込んでください。",
      "file": "c072.ogg",
      "durationSec": 6.168
    },
    {
      "index": 73,
      "text": "その温かさと静けさの中に息を吐き出します。",
      "file": "c073.ogg",
      "durationSec": 7.848
    },
    {
      "index": 74,
      "text": "吸い込む。",
      "file": "c074.ogg",
      "durationSec": 2.88
    },
    {
      "index": 75,
      "text": "息を吐きます。",
      "file": "c075.ogg",
      "durationSec": 3.504
    },
    {
      "index": 76,
      "text": "また。ソフトに吸い込みます。",
      "file": "c076.ogg",
      "durationSec": 6.552
    },
    {
      "index": 77,
      "text": "息を長く吐く。",
      "file": "c077.ogg",
      "durationSec": 3.888
    },
    {
      "index": 78,
      "text": "この想像の世界の地面に身体が支えられているのを感じてください。",
      "file": "c078.ogg",
      "durationSec": 10.056
    },
    {
      "index": 79,
      "text": "吸い込む。",
      "file": "c079.ogg",
      "durationSec": 2.88
    },
    {
      "index": 80,
      "text": "息を吐きます。",
      "file": "c080.ogg",
      "durationSec": 3.504
    },
    {
      "index": 81,
      "text": "考えがさまよったら、皮膚の温もりに戻りましょう。",
      "file": "c081.ogg",
      "durationSec": 7.728
    },
    {
      "index": 82,
      "text": "あるいは鼻の空気を冷やすためです。",
      "file": "c082.ogg",
      "durationSec": 6.36
    },
    {
      "index": 83,
      "text": "吸い込む。",
      "file": "c083.ogg",
      "durationSec": 2.88
    },
    {
      "index": 84,
      "text": "息を吐きます。",
      "file": "c084.ogg",
      "durationSec": 3.504
    },
    {
      "index": 85,
      "text": "吸い込む。",
      "file": "c085.ogg",
      "durationSec": 2.88
    },
    {
      "index": 86,
      "text": "息を吐きます。",
      "file": "c086.ogg",
      "durationSec": 3.504
    },
    {
      "index": 87,
      "text": "滞在する。柔らかくする。続く。",
      "file": "c087.ogg",
      "durationSec": 9.192
    },
    {
      "index": 88,
      "text": "吸い込む。",
      "file": "c088.ogg",
      "durationSec": 2.88
    },
    {
      "index": 89,
      "text": "息を吐きます。",
      "file": "c089.ogg",
      "durationSec": 3.504
    },
    {
      "index": 90,
      "text": "もう 1 つの簡単なサイクル。",
      "file": "c090.ogg",
      "durationSec": 5.184
    },
    {
      "index": 91,
      "text": "吸い込む。",
      "file": "c091.ogg",
      "durationSec": 2.88
    },
    {
      "index": 92,
      "text": "息を吐きます。",
      "file": "c092.ogg",
      "durationSec": 3.504
    },
    {
      "index": 93,
      "text": "この感覚をもう少し呼吸してください。",
      "file": "c093.ogg",
      "durationSec": 6.384
    },
    {
      "index": 94,
      "text": "暖かさ。柔らかさ。十分です。",
      "file": "c094.ogg",
      "durationSec": 9.12
    },
    {
      "index": 95,
      "text": "必要なときにいつでもこの場所に戻ることができます。",
      "file": "c095.ogg",
      "durationSec": 7.872
    },
    {
      "index": 96,
      "text": "それは想像力の中だけではなく、あなたの注意力の中に生きています。",
      "file": "c096.ogg",
      "durationSec": 10.704
    },
    {
      "index": 97,
      "text": "呼吸を深め始めます。",
      "file": "c097.ogg",
      "durationSec": 4.584
    },
    {
      "index": 98,
      "text": "あなたの周りの部屋をもう一度感じてください。",
      "file": "c098.ogg",
      "durationSec": 7.008
    },
    {
      "index": 99,
      "text": "指を小刻みに動かします。つま先を柔らかくします。",
      "file": "c099.ogg",
      "durationSec": 9.936
    },
    {
      "index": 100,
      "text": "準備ができたら、目を開けてください。",
      "file": "c100.ogg",
      "durationSec": 5.976
    },
    {
      "index": 101,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c101.ogg",
      "durationSec": 5.664
    },
    {
      "index": 102,
      "text": "この平穏を次に何が起こっても持ち続けてください。",
      "file": "c102.ogg",
      "durationSec": 7.944
    }
  ]
}
