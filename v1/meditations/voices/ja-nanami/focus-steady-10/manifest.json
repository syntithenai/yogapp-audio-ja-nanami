    {
      "index": 28,
      "text": "[休止:21]",
      "file": "c028.ogg",
      "durationSec": 4.08
    },
    {
      "index": 29,
      "text": "10まで黙って続けてから、1から始めます。",
      "file": "c029.ogg",
      "durationSec": 7.632
    },
    {
      "index": 30,
      "text": "[休止:90]",
