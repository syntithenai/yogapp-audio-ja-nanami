  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.384
    },
    {
      "index": 1,
      "text": "到着まで時間がかかります。",
      "file": "c001.ogg",
      "durationSec": 5.04
    },
    {
      "index": 2,
      "text": "サポートを受けながら座ったり横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 7.848
    },
    {
      "index": 3,
      "text": "安全だと感じたら目を閉じてください。",
      "file": "c003.ogg",
      "durationSec": 6.048
    },
    {
      "index": 4,
      "text": "地面との接触を感じます。",
      "file": "c004.ogg",
      "durationSec": 5.232
    },
    {
      "index": 5,
      "text": "ゆっくりと息を吸い込みます。",
      "file": "c005.ogg",
      "durationSec": 5.016
    },
    {
      "index": 6,
      "text": "息を長く吐く。",
      "file": "c006.ogg",
      "durationSec": 3.888
    },
    {
      "index": 7,
      "text": "[休止:21]",
      "file": "c007.ogg",
      "durationSec": 4.08
    },
    {
      "index": 8,
      "text": "また。",
      "file": "c008.ogg",
      "durationSec": 2.376
    },
    {
      "index": 9,
      "text": "[休止:21]",
      "file": "c009.ogg",
      "durationSec": 4.08
    },
    {
      "index": 10,
      "text": "肩を落としましょう。",
      "file": "c010.ogg",
      "durationSec": 3.912
    },
    {
      "index": 11,
      "text": "お腹を柔らかくしましょう。",
      "file": "c011.ogg",
      "durationSec": 4.752
    },
    {
      "index": 12,
      "text": "[休止:26]",
      "file": "c012.ogg",
      "durationSec": 4.152
    },
    {
      "index": 13,
      "text": "鼻孔での呼吸をポイントに選びましょう。",
      "file": "c013.ogg",
      "durationSec": 6.384
    },
    {
      "index": 14,
      "text": "空気感をそのままに。",
      "file": "c014.ogg",
      "durationSec": 4.392
    },
    {
      "index": 15,
      "text": "[休止:26]",
      "file": "c015.ogg",
      "durationSec": 4.152
    },
    {
      "index": 16,
      "text": "息を吐き出すたびに 1 から 10 まで数えます。",
      "file": "c016.ogg",
      "durationSec": 7.128
    },
    {
      "index": 17,
      "text": "カウントを失った場合は、お咎めなしで 1 からやり直します。",
