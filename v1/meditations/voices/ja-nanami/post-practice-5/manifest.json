      "durationSec": 7.92
    },
    {
      "index": 7,
      "text": "[休止:45]",
      "file": "c007.ogg",
      "durationSec": 3.888
    },
    {
      "index": 8,
      "text": "長く息を吐きます。",
      "file": "c008.ogg",
      "durationSec": 4.296
    },
    {
      "index": 9,
