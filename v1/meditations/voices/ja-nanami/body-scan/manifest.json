{
  "id": "body-scan",
  "voiceId": "ja-nanami",
  "edgeVoice": "ja-JP-NanamiNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 176,
  "chunks": [
    {
      "index": 0,
      "text": "丁寧に身体をスキャンしていきます。",
      "file": "c000.ogg",
      "durationSec": 6.0
    },
    {
      "index": 1,
      "text": "横になったり、楽に座ったりできます。",
      "file": "c001.ogg",
      "durationSec": 6.648
    },
    {
      "index": 2,
      "text": "安全だと感じたら目を閉じてください。",
      "file": "c002.ogg",
      "durationSec": 6.048
    },
    {
      "index": 3,
      "text": "頭頂部から始めます。",
      "file": "c003.ogg",
      "durationSec": 4.464
    },
    {
      "index": 4,
      "text": "そこにある感覚に注目してください。暖かさ。涼しさ。何もありません。",
      "file": "c004.ogg",
      "durationSec": 15.384
    },
    {
      "index": 5,
      "text": "変更する必要はありません。ただ気づいてください。",
      "file": "c005.ogg",
      "durationSec": 9.048
    },
    {
      "index": 6,
      "text": "額や目もとにそっとなじませます。",
      "file": "c006.ogg",
      "durationSec": 5.784
    },
    {
      "index": 7,
      "text": "目の周りの小さな筋肉を柔らかくしましょう。",
      "file": "c007.ogg",
      "durationSec": 7.344
    },
    {
      "index": 8,
      "text": "顎を感じてください。可能であれば、歯を緩めてください。",
      "file": "c008.ogg",
      "durationSec": 10.056
    },
    {
      "index": 9,
      "text": "舌は軽く休んでいます。",
      "file": "c009.ogg",
      "durationSec": 4.92
    },
    {
      "index": 10,
      "text": "肩。持ち上げられていますか？少し落としてみましょう。",
      "file": "c010.ogg",
      "durationSec": 10.728
    },
    {
      "index": 11,
      "text": "腕が重い。手が開いているか、柔らかいか。",
      "file": "c011.ogg",
      "durationSec": 8.76
    },
    {
      "index": 12,
      "text": "呼吸に合わせて胸が上がったり下がったりする。",
      "file": "c012.ogg",
      "durationSec": 7.008
    },
    {
      "index": 13,
      "text": "お腹が柔らかい。強制はありません。",
      "file": "c013.ogg",
      "durationSec": 7.608
    },
    {
      "index": 14,
      "text": "腰と骨盤は休んでいます。",
      "file": "c014.ogg",
      "durationSec": 5.208
    },
    {
      "index": 15,
      "text": "太もも。膝。下肢。",
      "file": "c015.ogg",
      "durationSec": 7.368
    },
    {
      "index": 16,
      "text": "足。足裏が床やマットに触れている状態。",
      "file": "c016.ogg",
      "durationSec": 8.808
    },
    {
      "index": 17,
      "text": "次に、体全体を 1 つの意識領域として感じます。",
      "file": "c017.ogg",
      "durationSec": 9.432
    },
    {
      "index": 18,
      "text": "その中を通る息。",
      "file": "c018.ogg",
      "durationSec": 4.296
    },
    {
      "index": 19,
      "text": "緊張した箇所が現れたら、そこに優しい息を送ります。",
      "file": "c019.ogg",
      "durationSec": 9.0
    },
    {
      "index": 20,
      "text": "3回静かに呼吸してください。",
      "file": "c020.ogg",
      "durationSec": 5.568
    },
    {
      "index": 21,
      "text": "準備ができたら、指と足の指を小刻みに動かします。",
      "file": "c021.ogg",
      "durationSec": 8.976
    },
    {
      "index": 22,
      "text": "目を開けてください。優しく返します。",
      "file": "c022.ogg",
      "durationSec": 7.728
    }
  ]
}
